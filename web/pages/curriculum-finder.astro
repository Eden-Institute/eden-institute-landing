---
// /curriculum-finder: the public homeschool curriculum finder (2026-11-19, Camila's taps: public page, no
// email to browse, "Email me my shortlist" to collect emails, an UNTICKED Friday box, free-trial links and a
// "completely free" filter). Indexable on purpose: built from curriculum_finder_list() at build time so every
// curriculum is in the HTML. NOT /curriculum, which is the noindex page for ESA reviewers.
// PUBLIC since 2026-11-19 (founder: "Make it public and make sure it ranks"); copy approved with that go.
import MarketingLayout from "../layouts/MarketingLayout.astro";
import CurriculumFinder, { finderSlug } from "../components/islands/CurriculumFinder";
import { FINDER_COPY, FINDER_FAQ, fetchFinderRows, finderCount } from "../lib/curriculumFinder";

const rows = await fetchFinderRows();
const meta = {
  title: FINDER_COPY.title(finderCount(rows)),
  description: FINDER_COPY.description(finderCount(rows)),
  canonical: "https://edeninstitute.health/curriculum-finder",
};
const itemList = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  name: FINDER_COPY.heading,
  numberOfItems: rows.length,
  itemListElement: rows.map((r, i) => ({ "@type": "ListItem", position: i + 1, name: r.name, url: `${meta.canonical}#${finderSlug(r.name)}` })),
};
const faqPage = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: FINDER_FAQ.map((f) => ({ "@type": "Question", name: f.q, acceptedAnswer: { "@type": "Answer", text: f.a } })),
};
---

<MarketingLayout title={meta.title} description={meta.description} canonical={meta.canonical} noindex={false}>
  <script type="application/ld+json" set:html={JSON.stringify(itemList)} />
  <script type="application/ld+json" set:html={JSON.stringify(faqPage)} />
  <main>
    <CurriculumFinder client:load rows={rows} />
  </main>
</MarketingLayout>
