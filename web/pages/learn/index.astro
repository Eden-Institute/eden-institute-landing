---
// /learn: the article index. Added 2026-09-25.
//
// Indexed since 2026-09-25, when the first six articles were approved and published
// (it was noindex while empty). Listed in web/lib/sitemapStaticPaths.ts and linked
// from the site footer. Articles are listed in /sitemap.xml by
// web/pages/sitemap.xml.ts. If every article is ever unpublished, put `noindex`
// back and take "/learn" out of the sitemap list.
import { getCollection } from "astro:content";
import MarketingLayout from "../../layouts/MarketingLayout.astro";

const articles = (await getCollection("learn", ({ data }) => !data.draft)).sort((a, b) =>
  b.data.published.localeCompare(a.data.published) || a.data.title.localeCompare(b.data.title),
);
---

<MarketingLayout
  title="Homeschool Help and Guides | Eden's Table"
  description="Plain answers for homeschool families: choosing a Christian science and nature study curriculum, teaching several ages at one table, and bringing plants and Scripture into your school week."
  canonical="https://edeninstitute.health/learn"
>
  <section class="pt-16 pb-10 md:pt-20 px-6" style="background-color:hsl(var(--eden-cream))">
    <div class="max-w-3xl mx-auto text-center">
      <p class="font-accent text-sm tracking-[0.3em] uppercase mb-4" style="color:hsl(var(--eden-gold-ink))">Eden's Table</p>
      <h1 class="font-serif text-3xl md:text-5xl font-bold leading-tight mb-4" style="color:hsl(var(--eden-bark))">Homeschool help and guides</h1>
      <p class="font-body text-lg text-muted-foreground leading-relaxed">
        Plain answers to the questions homeschool families ask us most.
      </p>
    </div>
  </section>

  <section class="py-14 px-6 bg-background">
    <div class="max-w-3xl mx-auto">
      {articles.length === 0 ? (
        <p class="font-body text-center text-muted-foreground">
          The first guides are on their way. In the meantime, <a href="/freebies" class="underline">Week 1 is free</a>.
        </p>
      ) : (
        <ul class="space-y-8">
          {articles.map((a) => (
            <li>
              <a href={`/learn/${a.slug}`} class="font-serif text-xl md:text-2xl font-bold underline-offset-4 hover:underline" style="color:hsl(var(--eden-forest))">{a.data.title}</a>
              <p class="font-body text-base text-muted-foreground leading-relaxed mt-1">{a.data.description}</p>
            </li>
          ))}
        </ul>
      )}
    </div>
  </section>
</MarketingLayout>
