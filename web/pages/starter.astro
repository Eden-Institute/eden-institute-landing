---
// /starter — Eden's Table Sprouts Starter Unit ($39 digital, weeks 1-9).
//
//
// COPY POSITION, and it is load-bearing. This is a STARTER UNIT: nine weeks with
// everything needed to teach them. It is never a "sample", "preview", "lite" or
// "partial" version, because every one of those words tells a reader that what
// they bought is the lesser thing. The plant cards are absent because they are
// made for hands, and that is stated as a design decision rather than an apology.
//
// 🛑 AND IT MUST NEVER READ AS THE WHOLE YEAR. Founder decision 2026-09-12: "I would
// hate to have someone purchase thinking it is the full year." Beside a $249 set, a
// $39 download can look like the same curriculum at a discount. Say "starter" and
// "one quarter of the year", and say weeks 1 to 9 of 36. Do NOT call the nine weeks
// "full" or "complete", or write "nothing is held back", anywhere a buyer could read
// it as the curriculum itself. The founder chose "starter" and "one quarter" over
// the word "partial" on this page. (The scholarship listings and /curriculum use
// "Partial Year" for reviewers; that is a separate surface.)
//
// 🔴 THE $39 KIT CREDIT IS STILL MINTED, AND IS NO LONGER ADVERTISED HERE.
// Founder decision 2026-09-12, the print-first pivot. The kit came off the site,
// so a credit against it cannot be sold as a benefit: there is nothing to spend
// it on today. stripe-webhook and starter-credit.ts are UNCHANGED and every
// Starter Unit purchase still mints a code. The plan is deliberate, in her words:
// when the boxed edition launches, Starter buyers are the first list she mails
// and the credit they did not know they had is what opens that email.
//
// So do NOT "fix" this by deleting the minting code, and do NOT put the credit
// back on the page while the kit is off sale. The hero credit panel, the bundled
// bullet, the credit FAQ and the closing kit CTA are all on b8751c1.
//
// Prices here are display copy. The only billing truth is the Stripe Price that
// create-checkout resolves from lookup_key "sprouts_starter_unit". Keep in sync
// with supabase/functions/_shared/starter-config.ts (STARTER_PRICE_CENTS 3900,
// STARTER_CREDIT_CENTS 3900).
//
// Copy rule: no em dashes (feedback_no_em_dashes).
import MarketingLayout from "../layouts/MarketingLayout.astro";
// Hero watermark: public domain botanical plate from Koehler's Medizinal-Pflanzen
// (1887), desaturated to a sage wash, feathered, and cleared through the middle
// where the text sits. See #428 for the full treatment and the contrast maths:
// muted-foreground on eden-cream is only 5.3:1 before any image, so the clearing
// is load-bearing, not decorative. Rendered at 24% with mix-blend-mode:multiply.
import heroStarter from "@/assets/hero-starter.jpg";
import StarterBuyBox from "../components/islands/StarterBuyBox.tsx";
import ComponentShowcases from "../components/ComponentShowcases.astro";

const PRICE = "$39";
const SET_PRICE = "$249";

const meta = {
  title: "Sprouts Starter Unit · Eden's Table | The Eden Institute",
  description:
    "The starter for Eden's Table Sprouts (K-2): weeks 1 to 9, one quarter of the 36-week year. Teacher's Guide, " +
    "Student Notebook and Read-Aloud storybook for those weeks, as an instant " + PRICE + " download.",
  canonical: "https://edeninstitute.health/starter",
};

const included = [
  {
    title: "One quarter of the year",
    body: "Weeks 1 to 9 of the 36-week Sprouts year, in order. Forty-five daily lessons, not excerpts. Weeks 10 to 36 are in the full year, the Printed Curriculum Set.",
  },
  {
    title: "A unit finished, and the next one opened",
    body: "Unit 1, In the Garden God Made, runs its full six weeks and closes. Then weeks 7 to 9 open Unit 2, When Your Body Talks, where the work turns from wonder at the design to reading the body's signals. You do not sample a unit. You finish one, and feel the year turn into the next.",
  },
  {
    title: "The Teacher's Guide",
    body: "Every daily lesson plan for those nine weeks, with the standards alignment, the botany behind each herb, and what to say when a five year old asks why.",
  },
  {
    title: "The Student Notebook",
    body: "The child's write-in pages: nine labelled botanical drawings, nine kitchen-lab observations, forty-five vocabulary words that never repeat, and a written review each week.",
  },
  {
    title: "The Read-Aloud Storybook",
    body: "The storybook has seven readings across the whole 36-week year, not one a week. Four of them fall inside these nine: the opening, Welcome to the Table, and then Life Force, Vovó's Lineage and Symptoms as Signals. The next one is not until week 18. A story reads aloud just as well from a screen, so it comes with your download.",
  },
  {
    title: "Sprouts, kindergarten through second grade",
    body: "Written for readers and pre-readers together, so an older sibling and a younger one can sit at the same table.",
  },
];

// Spec-required FAQ coverage: what happens after purchase, can it be printed,
// does it include the cards, how the credit works, other grade bands.
const faqs = [
  {
    q: "What happens right after I buy?",
    a: "You will get an email within about a minute with three download links: the Teacher's Guide, the Student Notebook and the Read-Aloud storybook. The links stay live for seven days. Save the files to your own device and they are yours to keep. If the links lapse before you get to them, there is a link in that same email to send yourself fresh ones.",
  },
  {
    q: "Can I print it?",
    a: "Yes. Print as much of it as you like for your own household, as often as you like. The Student Notebook in particular is meant to be printed, because children write in it. The Teacher's Guide and the Student Notebook are letter size, so they come straight off an ordinary home printer. The storybook is a smaller 6 by 8 storybook page, which prints on letter paper with a margin around it.",
  },
  {
    q: "Why nine weeks?",
    a: "Because nine weeks is a quarter of the year, and it is where the curriculum reaches a natural edge. Unit 1 finishes at week 6. Weeks 7 through 9 open Unit 2, so you see not just one unit but how the year moves between them. Four of the storybook's seven readings fall inside it, and the next one is not until week 18. Stopping at six would have handed you a finished unit and no idea what came after it.",
  },
  {
    q: "What is in the download, exactly?",
    a: "The Teacher's Guide, the Student Notebook and the Read-Aloud storybook for weeks 1 through 9, as PDFs you print at home. That is everything you need to teach those nine weeks, with no upgrade to buy to make them work. It is the starter, one quarter of the year. Weeks 10 through 36 are in the Printed Curriculum Set.",
  },
  {
    q: "My children are older than K-2. Should I wait for Seedlings?",
    a: "Almost always, no. Start with Sprouts. Skipping it does not move your child ahead, it removes 36 of the 72 plants they would otherwise finish with, and no later year goes back for them. The full reasoning is just above, under “Starting with Sprouts when your children are older”. Seedlings, for grades three through five, is in production and is not available as a starter unit yet.",
  },
  {
    q: "Will an older child find it babyish?",
    a: "This is the fear worth naming, so here is the honest answer. The reading level is K-2. The plant work is not. A nine year old identifying yarrow by the feel of the leaf underside is doing exactly what a fifteen year old does in Practitioners, with less vocabulary attached. What older children tend to resent is being talked down to, and the Teacher’s Guide never explains a plant twice. Take the nine weeks for $39 and let your child tell you, rather than guessing on their behalf.",
  },
  {
    q: "Is it refundable?",
    a: "Because it is a digital download, it is not refundable once the files have been downloaded. That is stated here rather than after you buy, so you can decide with it in front of you. If something is wrong with the files, email hello@edeninstitute.health and we will fix it.",
  },
];

const productJsonLd = {
  "@context": "https://schema.org",
  "@type": "Product",
  name: "Eden's Table: Sprouts Starter Unit",
  sku: "sprouts_starter_unit",
  description:
    "The starter: weeks 1 to 9, one quarter of the 36-week Eden's Table Sprouts (K-2) Biblical herbalism curriculum, delivered as PDF. " +
    "Includes the Teacher's Guide, the Student Notebook and the Read-Aloud storybook for those nine weeks.",
  brand: { "@type": "Brand", name: "Eden's Table" },
  offers: {
    "@type": "Offer",
    price: "39.00",
    priceCurrency: "USD",
    availability: "https://schema.org/InStock",
    url: "https://edeninstitute.health/starter",
  },
};

const faqJsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map((f) => ({
    "@type": "Question",
    name: f.q,
    acceptedAnswer: { "@type": "Answer", text: f.a },
  })),
};
---

<MarketingLayout
  title={meta.title}
  description={meta.description}
  canonical={meta.canonical}
  jsonLd={[productJsonLd, faqJsonLd]}
>
  <!-- HERO. The credit is inside it, deliberately, because it is the reason the
       product exists.
       MEASURED ON A 375x812 PHONE, which is where most of this traffic lands.
       The first draft put the buy button at y=782 with a height of 52, so its
       bottom half sat below the fold: the primary CTA was clipped on the primary
       device. Every mobile size below (pt, text size, margins) is tuned so the
       credit box AND the whole button clear 812px. If you edit this hero, measure
       it again rather than eyeballing it. Desktop keeps the larger type via md:. -->
  <section class="relative overflow-hidden pt-12 md:pt-20 pb-10 md:pb-12 px-6" style="background-color:hsl(var(--eden-cream))">
    <img src={heroStarter.src} alt="" aria-hidden="true" class="absolute inset-0 w-full h-full object-cover pointer-events-none select-none" style="opacity:0.95;mix-blend-mode:multiply" />
    <div class="relative z-10 max-w-3xl mx-auto text-center rounded-lg" style="background-color:hsl(0 0% 100% / 0.92);border:1px solid hsl(var(--eden-gold) / 0.35);padding:clamp(26px, 3.5vw, 52px);box-shadow:0 2px 18px -10px rgba(30,62,46,0.28)">
      <p class="font-accent text-sm tracking-[0.3em] uppercase mb-3 md:mb-4" style="color:hsl(var(--eden-gold-ink))">
        Eden's Table · Sprouts, K-2
      </p>
      <h1 class="font-serif text-4xl md:text-5xl font-bold leading-tight mb-4 md:mb-6" style="color:hsl(var(--eden-bark))">
        Start teaching this week.
      </h1>
      <div class="w-16 h-px mx-auto my-4 md:my-6" style="background-color:hsl(var(--eden-gold-ink))"></div>
      <p class="font-body text-base md:text-xl text-muted-foreground leading-relaxed mb-5 md:mb-8" style="color:hsl(var(--eden-bark))">
        The first nine weeks of Eden's Table, Sprouts, one quarter of the 36-week year. The
        Teacher's Guide, the Student Notebook and the Read-Aloud storybook for those weeks, as
        an instant download for {PRICE}.
        Sit down with it tonight
        and know whether this is the way your family wants to learn plants.
      </p>

      {/* Was the kit-credit panel until 2026-09-12. Replaced with what the nine
          weeks actually are, since the credit is no longer advertised. An HTML
          comment would ship this text to the page source, so it is an Astro
          expression comment. */}
      <div
        class="rounded-lg p-4 md:p-6 mb-5 md:mb-8 text-left md:text-center"
        style="background-color:hsl(var(--background));border:2px dashed hsl(var(--eden-gold))"
      >
        <p class="font-accent text-xs tracking-[0.25em] uppercase mb-2 md:mb-3" style="color:hsl(var(--eden-gold-ink))">
          The starter: one quarter of the year
        </p>
        <p class="font-body text-sm md:text-lg leading-relaxed" style="color:hsl(var(--eden-bark))">
          Weeks 1 to 9 of 36, with everything you need to teach them: forty-five daily lessons,
          the write-in Notebook pages and four storybook readings. Teach it tonight and decide
          about the rest of the year later.
        </p>
      </div>

      <div id="early-access" class="flex justify-center scroll-mt-28">
        <StarterBuyBox client:only="react" cta="starter-hero-buy" wide={true} />
      </div>
    </div>
  </section>

  <!-- WHAT IS INCLUDED -->
  <section class="py-16 px-6 bg-background">
    <div class="max-w-4xl mx-auto">
      <h2 class="font-serif text-3xl font-bold mb-8 text-center" style="color:hsl(var(--eden-forest))">
        What you get
      </h2>
      {/* The polished product image plus the short list, before the long copy.
          A buyer scanning on a phone gets the whole answer in one screen. */}
      <div class="grid gap-8 md:grid-cols-[1fr_1.1fr] items-center mb-10">
        <div class="rounded-lg overflow-hidden bg-white shadow-sm border" style="border-color:hsl(var(--eden-gold) / 0.3)">
          <img src="/showcases/ET_StarterUnit.webp" alt="Sprouts Starter Unit: the Teacher's Guide, Student Notebook and Read-Aloud Storybook for the first nine weeks, as a digital download" loading="lazy" width="1024" height="1024" class="w-full h-auto" />
        </div>
        <ul class="font-body text-base space-y-3" style="color:hsl(var(--eden-bark))">
          <li class="flex gap-3"><span style="color:hsl(var(--eden-gold-ink))">·</span><span><strong>Teacher's Guide, weeks 1 to 9.</strong> Forty-five daily lesson plans, scripted, with the Week at a Glance for each week.</span></li>
          <li class="flex gap-3"><span style="color:hsl(var(--eden-gold-ink))">·</span><span><strong>Student Notebook, weeks 1 to 9.</strong> Her write-in pages: drawings, kitchen-lab observations, vocabulary, weekly review.</span></li>
          <li class="flex gap-3"><span style="color:hsl(var(--eden-gold-ink))">·</span><span><strong>Read-Aloud Storybook.</strong> The four readings that fall in these nine weeks.</span></li>
          <li class="flex gap-3"><span style="color:hsl(var(--eden-gold-ink))">·</span><span><strong>PDF, instant download.</strong> Print at home; letter size for the two books, small storybook page for the stories.</span></li>
          <li class="flex gap-3"><span style="color:hsl(var(--eden-gold-ink))">·</span><span><strong>Yours to keep and reprint.</strong> Print it again for the next child, as often as you like.</span></li>
        </ul>
      </div>
      <div class="grid gap-4 md:grid-cols-2">
        {included.map((item) => (
          <div class="rounded-lg p-5 bg-white border" style="border-color:hsl(var(--eden-gold) / 0.3)">
            <h3 class="font-serif text-lg font-bold mb-2" style="color:hsl(var(--eden-forest))">{item.title}</h3>
            <p class="font-body text-sm text-muted-foreground leading-relaxed">{item.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  {/* The three books, with the same copy and photos as the hub. The note under
      each heading keeps the claim honest: nine weeks of it, not thirty-six. */}
  <ComponentShowcases only={["story", "tg", "nb"]} note="In the Starter Unit: weeks 1 to 9 of this, as a download." cta={{ href: "#early-access", label: "Get the Starter Unit · $39", dataCta: "starter-showcase-buy" }} />

  <!-- WEEK 9. The only genuinely new EXPERIENCE the three extra weeks buy, so it
       gets a band of its own rather than a line in a card. Every lab in weeks 1
       to 8 is finished in one sitting; week 9 is the first that is not, and that
       is the honest answer to "why nine and not six". Verified against the
       Teacher's Guide, Week 09 Wednesday: 2 Tbsp root, 2 cups cool water, soak
       4 hours or overnight, strain, sweeten. Do not inflate that into a long
       steep; the curriculum is same-day by design and says so. -->
  <section class="py-16 px-6 bg-background">
    <div class="max-w-2xl mx-auto text-center">
      <p class="font-accent text-xs tracking-[0.25em] uppercase mb-4" style="color:hsl(var(--eden-gold-ink))">
        The ninth week
      </p>
      <h2 class="font-serif text-3xl font-bold mb-6" style="color:hsl(var(--eden-bark))">
        By week nine, it is not just tea.
      </h2>
      <p class="font-body text-lg text-muted-foreground leading-relaxed">
        The first labs are quick. Measure, pour, steep five minutes, taste. By Week 9 your
        child meets marshmallow root, and it does not work that way. Its softness will not
        come out in hot water, so the jar is filled with cool water in the morning and then
        left alone. Hours later they come back, strain the silky liquid through a sieve, stir
        in honey, and taste what waiting made. It is the first lab in the curriculum a child
        starts and has to return to, and it is a good part of why the unit runs to nine weeks
        rather than six.
      </p>
    </div>
  </section>

  {/* Was the "plant cards stay in the box" section, which existed to explain an
      absence against the kit. With the kit off the site there is no absence to
      explain, so the section says what the nine weeks give you instead. The old
      copy is on b8751c1. */}
  <section class="py-16 px-6" style="background-color:hsl(var(--eden-cream))">
    <div class="max-w-2xl mx-auto text-center">
      <p class="font-accent text-xs tracking-[0.25em] uppercase mb-4" style="color:hsl(var(--eden-gold-ink))">
        Nine weeks, finished
      </p>
      <h2 class="font-serif text-3xl font-bold mb-6" style="color:hsl(var(--eden-bark))">
        This is not a preview of the curriculum. It is a quarter of it.
      </h2>
      <p class="font-body text-lg text-muted-foreground leading-relaxed">
        Forty-five daily lessons, written out the same way every other week of the year is
        written out. The same kitchen labs, the same memory work, the same dinner-table
        questions, the same stories. Nothing is thinned down because it is the trial. If you
        teach these nine weeks and stop, your child has still learned nine plants by sight and
        you have still had nine weeks of school you did not have to plan.
      </p>
    </div>
  </section>

  <!-- OLDER CHILDREN. The single biggest objection to a K-2 product, and the one
       that loses the sale silently: a parent with an eight year old decides this
       is not for them and closes the tab without ever asking.
       A VISIBLE section, not a collapsed FAQ row, and deliberately so. Accordion
       content is hidden by default, and hidden copy does not handle objections.
       /homeschool deep-links here (#older-kids) from beside the four band cards,
       which is exactly where that doubt forms. -->
  <section id="older-kids" class="py-16 px-6 scroll-mt-20 bg-background">
    <div class="max-w-3xl mx-auto">
      <div class="text-center mb-10">
        <p class="font-accent text-xs tracking-[0.25em] uppercase mb-4" style="color:hsl(var(--eden-gold-ink))">
          If your children are older
        </p>
        <h2 class="font-serif text-3xl md:text-4xl font-bold leading-tight mb-5" style="color:hsl(var(--eden-bark))">
          Starting with Sprouts when your children are older.
        </h2>
        <p class="font-body text-lg text-muted-foreground leading-relaxed">
          Parents of eight, ten and twelve year olds ask this constantly, and the honest
          answer surprises most of them. Start here anyway. Four reasons.
        </p>
      </div>

      <div class="space-y-5">
        <div class="rounded-lg p-6 bg-white border" style="border-color:hsl(var(--eden-gold) / 0.35)">
          <h3 class="font-serif text-xl font-bold mb-2" style="color:hsl(var(--eden-forest))">
            1. Skipping Sprouts costs you 36 plants, permanently.
          </h3>
          <p class="font-body text-base text-muted-foreground leading-relaxed">
            Sprouts and Seedlings are not the same year at two reading levels. They teach
            <strong>different plants</strong>. Sprouts covers 36. Seedlings covers another 36.
            A family who works through both finishes with <strong>72 named and usable
            species</strong>, which is a real apothecary. Begin at Seedlings and the first 36
            are simply gone, because no later band circles back to collect them.
          </p>
        </div>

        <div class="rounded-lg p-6 bg-white border" style="border-color:hsl(var(--eden-gold) / 0.35)">
          <h3 class="font-serif text-xl font-bold mb-2" style="color:hsl(var(--eden-forest))">
            2. Sprouts is the first pass, not the shallow one.
          </h3>
          <p class="font-body text-base text-muted-foreground leading-relaxed">
            Those 72 plants come back. In Cultivators, grades 6 to 8, your child meets them
            again through body pattern thinking and terrain. In Practitioners, grades 9 to 12,
            they meet them a third time at clinical depth. The plant a seven year old learns to
            recognize by smell is the same plant they reason about at sixteen. Missing the
            first pass does not save a year. It removes the floor the next two stand on.
          </p>
        </div>

        <div class="rounded-lg p-6 bg-white border" style="border-color:hsl(var(--eden-gold) / 0.35)">
          <h3 class="font-serif text-xl font-bold mb-2" style="color:hsl(var(--eden-forest))">
            3. The sensory work is the actual skill being taught.
          </h3>
          <p class="font-body text-base text-muted-foreground leading-relaxed">
            Crush the leaf. Smell it. Taste it. Turn it over and feel the underside. That is not
            a warm-up for the real lesson, it <em>is</em> the lesson, and it is how a child
            learns to approach any living thing: look closely, use every sense, notice before
            you name. A child who skips it learns <em>about</em> plants. A child who does it
            learns to <em>know</em> them, and that habit of observation carries into every
            nature study they ever do. It is the one thing that genuinely does not transfer
            from a book, and it is the reason age matters less here than people expect.
          </p>
        </div>

        <div class="rounded-lg p-6 bg-white border" style="border-color:hsl(var(--eden-gold) / 0.35)">
          <h3 class="font-serif text-xl font-bold mb-2" style="color:hsl(var(--eden-forest))">
            4. One year, taught once, to every child at your table.
          </h3>
          <p class="font-body text-base text-muted-foreground leading-relaxed">
            The reading level is K-2 so the youngest can join, and the plant work is real enough
            that the oldest is not bored by it. You teach one week, once, to everybody. An older
            child simply goes further within it: longer notebook entries, the botanical drawing
            done properly, the harder questions on the discussion cards. They also move faster,
            so a year of Sprouts often takes an older child considerably less than a year.
          </p>
        </div>
      </div>

      <div class="text-center mt-10">
        <p class="font-body text-base text-muted-foreground leading-relaxed mb-6 max-w-xl mx-auto">
          You do not have to take our word for any of this. Nine weeks is $39, which is about
          four dollars a week, and your child will tell you the rest.
        </p>
        <div class="flex justify-center">
          <StarterBuyBox client:only="react" cta="starter-olderkids-buy" wide={true} />
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="py-16 px-6 bg-background">
    <div class="max-w-2xl mx-auto">
      <h2 class="font-serif text-3xl font-bold mb-8 text-center" style="color:hsl(var(--eden-forest))">
        Questions
      </h2>
      <div class="space-y-4">
        {faqs.map((f) => (
          <details class="rounded-lg bg-white border p-5" style="border-color:hsl(var(--eden-gold) / 0.3)">
            <summary class="font-serif text-base font-bold cursor-pointer" style="color:hsl(var(--eden-forest))">
              {f.q}
            </summary>
            <p class="font-body text-sm text-muted-foreground leading-relaxed mt-3">{f.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- CLOSING BUY + the route on to the printed year -->
  <section class="py-16 px-6" style="background-color:hsl(var(--eden-cream))">
    <div class="max-w-2xl mx-auto text-center">
      <h2 class="font-serif text-3xl font-bold mb-6" style="color:hsl(var(--eden-bark))">
        Nine weeks, {PRICE}, in your inbox in a minute.
      </h2>
      <div class="flex justify-center mb-10">
        <StarterBuyBox client:only="react" cta="starter-bottom-buy" wide={true} />
      </div>

      <div class="pt-8" style="border-top:1px solid hsl(var(--eden-gold) / 0.4)">
        <p class="font-body text-base text-muted-foreground leading-relaxed mb-4">
          Already know you want the whole year? The Printed Curriculum Set is all 36 weeks in
          three printed books, {SET_PRICE} plus flat $12 shipping, printed to order and at your
          door in about two weeks.
        </p>
        <a
          href="/books"
          data-cta="starter-to-books-upgrade"
          class="inline-block font-accent text-sm tracking-[0.2em] uppercase font-bold px-8 py-4 rounded-md border-2"
          style="border-color:hsl(var(--eden-forest));color:hsl(var(--eden-forest))"
        >
          See the printed year
        </a>
      </div>
    </div>
  </section>
</MarketingLayout>
