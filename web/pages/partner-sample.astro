---
// /partner-sample — private download page for founding partners.
//
// Reached only via the link the founder pastes into her welcome email. The
// email carries ONE short edeninstitute.health URL instead of six Supabase
// signed URLs, because Gmail rewrites every link in an API-created draft
// through google.com/url with no `usg` signature, landing the recipient on a
// "Redirect Notice" interstitial per button. Links the founder types or pastes
// herself are not rewritten, so a single pasted URL arrives clean.
//
// The link comes in two equivalent forms. Prefer the path form when pasting:
//   /partner-sample/<key>    302s to the query form via vercel.json
//   /partner-sample?k=<key>  the original, still honoured for links already sent
// The path form was added 2026-09-02 because hand-pasting the query form dropped
// the `?k=` twice and partners got "This link is incomplete". Note the redirect
// cannot be a rewrite: the `k` below is read from window.location.search on the
// client, so the browser URL has to end up carrying the query.
//
// NO THIRD-PARTY TAGS HERE (noThirdPartyTags below). The key stays in the URL,
// so every link already sent keeps working forever, copied, bookmarked or
// opened in another browser. That is only safe because nothing on this page can
// read the URL and send it on: no Google Analytics, no Google Tag Manager, no
// Pinterest tag, no Meta Pixel, and a no-referrer policy for everything the
// page fetches or opens. Forms that would otherwise fall through to the SPA
// (which loads Google Analytics) with the key in the URL, such as
// /partner-sample/<key>/ with a trailing slash or /Partner-Sample, are redirected
// by vercel.json to this page first.
//
// The `?k=` secret is validated by /api/partner-sample, which brokers a short
// lived signed URL per click. This page holds no credentials: without a valid
// k every button 403s, so the page itself is harmless if it is ever found.
// noindex keeps it out of search results regardless (robots.txt deliberately
// does not Disallow it, or crawlers could never read the noindex).
import MarketingLayout from "../layouts/MarketingLayout.astro";

const meta = {
  title: "Your Eden's Table sample · The Eden Institute",
  description: "Private download page for Eden's Table founding partners.",
  canonical: "https://edeninstitute.health/partner-sample",
};

// Three weeks of each band (founder decision 2026-09-24), grouped so a partner
// can compare Sprouts and Seedlings side by side. Reading order within a band.
// Slugs must match COMPONENTS in api/partner-sample.ts.
const pieces = [
  { key: "read-aloud", label: "Read-Aloud", note: "The stories for these three weeks, read together." },
  { key: "teachers-guide", label: "Teacher's Guide", note: "Everything you need to teach each week." },
  { key: "student-notebook", label: "Student Notebook", note: "The child's write-in pages." },
];
const bands = [
  { id: "sprouts", title: "Sprouts", grades: "Grades K-2", intro: "Weeks 1 to 3: lavender, chamomile and lemon balm." },
  { id: "seedlings", title: "Seedlings", grades: "Grades 3-5", intro: "Weeks 1 to 3: elderberry, tulsi and ginger." },
].map((b) => ({ ...b, components: pieces.map((c) => ({ ...c, slug: `${b.id}-${c.key}` })) }));
---

<MarketingLayout
  title={meta.title}
  description={meta.description}
  canonical={meta.canonical}
  noindex={true}
  noThirdPartyTags={true}
>
  <section class="pt-20 pb-10 px-6" style="background-color:hsl(var(--eden-cream))">
    <div class="max-w-2xl mx-auto text-center">
      <p class="font-accent text-sm tracking-[0.3em] uppercase mb-4" style="color:hsl(var(--eden-gold-ink))">
        Founding Partner
      </p>
      <h1 class="font-serif text-4xl md:text-5xl font-bold leading-tight mb-6" style="color:hsl(var(--eden-bark))">
        Your Eden's Table sample
      </h1>
      <div class="w-16 h-px mx-auto my-6" style="background-color:hsl(var(--eden-gold))"></div>
      <p class="font-body text-lg text-muted-foreground leading-relaxed">
        Three weeks of Sprouts (K-2) and three weeks of Seedlings (grades 3-5), so you can compare. Yours to keep, so take your time with it.
      </p>
    </div>
  </section>

  <section class="py-12 px-6 bg-background">
    <div class="max-w-2xl mx-auto">
      <div id="ps-locked" class="hidden rounded-lg p-6 bg-white border text-center" style="border-color:hsl(var(--eden-gold) / 0.4)">
        <h2 class="font-serif text-lg font-bold mb-2" style="color:hsl(var(--eden-forest))">
          This link is incomplete
        </h2>
        <p class="font-body text-sm text-muted-foreground leading-relaxed">
          Please open the full link from your welcome email. If it still does not work,
          reply to that email or write to hello@edeninstitute.health and we will send you
          a fresh one the same day.
        </p>
      </div>

      <div id="ps-downloads" class="hidden space-y-10">
        {bands.map((b) => (
          <div>
            <div class="mb-4">
              <h2 class="font-serif text-2xl font-bold" style="color:hsl(var(--eden-bark))">
                {b.title} <span class="font-body text-base font-normal text-muted-foreground">{b.grades}</span>
              </h2>
              <p class="font-body text-sm text-muted-foreground">{b.intro}</p>
            </div>
            <div class="space-y-3">
              {b.components.map((c) => (
                <a
                  href="#"
                  data-slug={c.slug}
                  class="ps-dl flex items-center justify-between gap-4 rounded-lg p-5 bg-white border no-underline transition-colors hover:bg-[hsl(var(--eden-cream))]"
                  style="border-color:hsl(var(--eden-gold) / 0.3)"
                >
                  <span>
                    <span class="block font-serif text-base font-bold" style="color:hsl(var(--eden-forest))">{c.label}</span>
                    <span class="block font-body text-sm text-muted-foreground">{c.note}</span>
                  </span>
                  <span
                    class="shrink-0 font-accent text-xs tracking-[0.2em] uppercase border-2 px-4 py-2"
                    style="border-color:hsl(var(--eden-forest));color:hsl(var(--eden-forest))"
                  >Download</span>
                </a>
              ))}
            </div>
          </div>
        ))}

        <p class="font-body text-sm text-muted-foreground leading-relaxed pt-6">
          These are digital files of a curriculum that will only ever exist in print, so
          please keep them within your own family rather than sharing or forwarding them.
          Thank you for guarding that with us.
        </p>
      </div>
    </div>
  </section>

  <script is:inline>
    // The secret travels in the URL the founder pastes. It is never stored in
    // this page, so a crawler or a stray visitor gets the "incomplete" panel.
    (function () {
      var k = new URLSearchParams(window.location.search).get("k");
      var downloads = document.getElementById("ps-downloads");
      var locked = document.getElementById("ps-locked");
      if (!k) {
        locked.classList.remove("hidden");
        return;
      }
      var links = document.querySelectorAll("a.ps-dl");
      for (var i = 0; i < links.length; i++) {
        links[i].setAttribute(
          "href",
          "/api/partner-sample?k=" + encodeURIComponent(k) + "&f=" + links[i].getAttribute("data-slug")
        );
      }
      downloads.classList.remove("hidden");
    })();
  </script>
</MarketingLayout>
