---
// /homeschool — Astro port of src/pages/Homeschool.tsx. Pre-rendered to static
// HTML for SEO (the page's whole reason for existing). Content/classes mirror
// the React page exactly. The signup CTAs are static buttons with
// data-waitlist-* attrs; WaitlistController (one island) opens the modal.
import MarketingLayout from "../layouts/MarketingLayout.astro";
import DualLeadMagnetCTAs from "../components/DualLeadMagnetCTAs.astro";
import CoopLicensing from "../components/CoopLicensing.astro";
import WaitlistController from "../components/islands/WaitlistController.tsx";
import { Button } from "@/components/ui/button";
import { Sprout, BookOpen, Users } from "lucide-react";

const meta = {
  title: "Christian Homeschool Herbalism Curriculum (K-12) | Eden's Table",
  description:
    "A Christ-centered homeschool curriculum that teaches Biblical herbalism and the body God designed — open-and-go weekly lessons for K-2 and 3-5, rooted in Scripture and creation stewardship.",
  canonical: "https://edeninstitute.health/homeschool",
};

// Course structured data — baked statically into the page <head> (was injected
// at runtime via useEffect in the React version, so crawlers never saw it).
const courseJsonLd = {
  "@context": "https://schema.org",
  "@type": "Course",
  name: "Eden's Table — Christian Homeschool Herbalism Curriculum",
  description:
    "A Christ-centered, Scripture-anchored K-12 homeschool curriculum teaching herbalism and the body God designed. Open-and-go weekly lessons for Sprouts (K-2) and Seedlings (3-5).",
  url: "https://edeninstitute.health/homeschool",
  inLanguage: "en",
  educationalLevel: "K-12",
  about: ["Christian homeschool curriculum", "Biblical herbalism", "Faith-based science", "creation stewardship"],
  provider: { "@type": "Organization", name: "The Eden Institute", url: "https://edeninstitute.health" },
  audience: { "@type": "EducationalAudience", educationalRole: "homeschooling family" },
};

// Free two-week sample CTAs — the magnet capture that also feeds launch/preorder
// updates (replaces the old "reserve Founders pricing" waitlist framing).
const SPROUTS_MAGNET = {
  source: "sprouts_magnet",
  title: "Your free 2-week Sprouts sample",
  subtitle: "Five full lessons, yours to print and teach. We'll also email you the moment preorder opens.",
};
const SEEDLINGS_MAGNET = {
  source: "seedlings_magnet",
  title: "Your free 2-week Seedlings sample",
  subtitle: "Five full lessons at Seedlings depth. We'll also email you when Seedlings opens.",
};
const FACEBOOK_URL = "https://www.facebook.com/TheEdenInstituteBiblicalHerbalism/";

// Component showcases. Copy is deliberately BAND-AGNOSTIC: one description sells
// both Sprouts (K-2) and Seedlings (3-5), because the two bands are the same six
// components at two depths. The per-showcase `deepens` line carries the band
// difference so the comparison isn't lost.
//
// IMAGES: every image is a design mockup from the founder's Mockups folder
// (Products/App/Eden Apothecary/_showcase_assets/Bundles/Mockups) — founder
// decision 2026-07-17: ONLY that folder, all 11 images. See the disclaimer
// section below; nothing is printed yet. Note the TG/NB/storybook interior
// spreads carry AI-garbled micro-text at zoom — swap in regenerated files
// (same ET_*.webp names) when the founder updates the folder.
// insideW/insideH are the intrinsic dimensions, reserved to prevent layout shift.
const SHOWCASES = [
  {
    id: "story",
    eyebrow: "Component 1 · Read-Aloud Storybook",
    title: "Every week begins with a story.",
    src: "/showcases/ET_Story_Cover.webp",
    alt: "Eden's Table Read-Aloud Storybook, cover",
    insideSrc: "/showcases/ET_Story_Inside.webp",
    insideAlt: "Read-Aloud Storybook open to the introductory story, Meet the Family",
    insideLabel: "Inside the storybook",
    insideW: 1024,
    insideH: 1024,
    deepens: "The same family, carried across both bands. A simple parable at K-2 becomes a story of real choices at 3-5.",
    body: "Before there is a lesson about a plant, there is a family. Vovó in the garden. PopPop with his hands in the dirt. A scraped knee, a jar on a windowsill, a grandmother who knows which flower to reach for. The botany, the scripture, and the kitchen lab all hang on that narrative hook, which is why a child who cannot yet define a term can still tell you exactly why Vovó chose the plant she chose. This is the piece that makes the curriculum stick, and it is the piece most curricula skip. Facts taught cold are facts forgotten by Friday.",
    quote: "It is the least academic-looking thing in the box, and it is doing the most important work in it.",
  },
  {
    id: "tg",
    eyebrow: "Component 2 · Teacher's Guide",
    title: "You do not need to know herbalism to teach this.",
    src: "/showcases/ET_TG_Cover.webp",
    alt: "Eden's Table Teacher's Guide, spiral-bound cover",
    insideSrc: "/showcases/ET_TG_Inside.webp",
    insideAlt: "Teacher's Guide open to a calendula week spread, with the Week at a Glance, read-aloud and discussion pages",
    insideLabel: "Inside the guide",
    insideW: 1024,
    insideH: 1024,
    deepens: "Every lesson is written at two depths, so a younger and an older child work the same week at one table.",
    body: "Open the guide on Monday morning and the week is already built. The read-aloud is scripted, the discussion questions are written, the memory verse is chosen, and the kitchen lab tells you exactly which supplies to set on the counter. Nothing is left for you to research the night before. What makes this guide unusual is how much it carries at once: a single week on a single plant quietly weaves Bible, science, language arts, math, art, history, geography, Latin, health, and character, and the Week at a Glance page tells you which day carries which. You are not stacking ten subjects into a day. You are teaching one plant well, and the disciplines come with it.",
    quote: "It lies flat on the counter while your hands are busy, open to Wednesday, while the herb steeps.",
  },
  {
    id: "nb",
    eyebrow: "Component 3 · Student Notebook",
    title: "The book your child fills in herself.",
    src: "/showcases/ET_NB_Cover.webp",
    alt: "Eden's Table Student Notebook, spiral-bound cover",
    insideSrc: "/showcases/ET_NB_Inside.webp",
    insideAlt: "Student Notebook open to the Tuesday Discovery and Wednesday Kitchen Lab spread, with observation fields and a star rating",
    insideLabel: "Inside the notebook",
    insideW: 1024,
    insideH: 1024,
    deepens: "Color, smell, taste and texture at K-2 become measurements, ratios, and a hypothesis at 3-5.",
    body: "It is a consumable workbook, but calling it that undersells what happens on the page. She draws the plant she just held. She records what it smelled like. She answers, in her own handwriting, a question that has no answer key, because some of the best questions in this curriculum genuinely do not have one. The enrichment work is deliberately marked optional, complete it if you have time, because a curriculum that punishes a hard week is a curriculum abandoned in February. This is also the practical answer to the record-keeping question: dated, sequential, in your child's own hand, showing observation, narration, scripture copywork, and real measurement across thirty-six weeks.",
    quote: "It satisfies a reviewer. Far more importantly, it is the thing she carries to her grandfather and says look what I made.",
  },
  {
    id: "fc",
    eyebrow: "Component 4 · Herb Field Cards",
    title: "By the end of the year she can name plants most adults cannot.",
    src: "/showcases/ET_FieldCards.webp",
    alt: "Eden's Table Herb Field Cards with storage box, showing a calendula card front and back",
    deepens: "Each band covers a different 36 plants. A family that works through both ends with 72 named and usable species.",
    body: "Each card carries a heritage botanical illustration on the front, the kind you would expect in a nineteenth-century plate book, alongside the plant's common name and its Latin binomial. The back is the working side: what the plant tastes like, what it does, and how it is prepared at a level your child can genuinely handle. The card format does something a textbook cannot. It is portable, so it goes in a pocket on a walk. It is durable, so it survives the walk. And it is a set, which triggers the collecting instinct children already have. Children who will not sit still for a botany chapter will absolutely sort, quiz, and trade a deck of cards they own.",
    quote: "The learning stops being confined to school hours and starts following your family outdoors.",
  },
  {
    id: "rc",
    eyebrow: "Component 5 · Recipe Cards",
    title: "The card that lives on your counter.",
    src: "/showcases/ET_RecipeCards.webp",
    alt: "Eden's Table Recipe Cards with display box, showing a calendula skin dressing card",
    deepens: "Steeping and infusing early. Decoctions, oxymels, and syrups later.",
    body: "Each week's kitchen lab gets its own card: what to gather, what to do, in steps your child can follow with your hands nearby. The preparations are matched to what she can actually manage at her level, which means they start simple and grow genuinely ambitious as she does. Wednesday is the day the week stops being about a plant and starts being with one. Your child measures, steeps, stirs, smells, and tastes, then records what she observed in her notebook and says whether it worked. Real chemistry, learned the way it has always been learned in a family kitchen, with an adult paying attention. Safety instruction is printed on the card itself rather than buried in a manual, so the caution arrives at the moment it is needed.",
    quote: "Long after the week is finished, your child is still the one who says I know how to make that, and then does.",
  },
  {
    id: "att",
    eyebrow: "Component 6 · Around the Table",
    title: "Four questions a week, and the curriculum walks into your dinner.",
    src: "/showcases/ET_ATTCards.webp",
    alt: "Eden's Table Around the Table discussion cards with box, showing Body, Faith, Family and Wonder cards",
    deepens: "Same four categories at both bands. At 3-5 the questions add abstract reasoning and the classical tradition.",
    body: "Each week's set carries one card in each of four directions: Body, Faith, Family, and Wonder. What is happening inside you when a wound heals. What God says about healing and the healed. What it means to care for the people at this table. And the questions with no clean answer at all, the ones a child turns over for days. These are written as genuine questions, not comprehension checks with an answer in the back. Nobody is being quizzed. A young child, an older sibling, and a grandparent can all answer the same card honestly and differently, which is exactly the conversation you want.",
    quote: "It is the difference between a curriculum your family completes and a curriculum your family talks about.",
  },
];

// The kit section (§9.4) — the six components as one purchase.
const KIT = {
  closedSrc: "/showcases/ET_Kit_Closed.webp",
  closedAlt: "The Eden's Table complete curriculum kit box, closed",
  openSrc: "/showcases/ET_Kit_Open.webp",
  openAlt: "The Eden's Table kit box open, showing the Teacher's Guide, Student Notebook, storybook and all three card decks",
};
---

<MarketingLayout title={meta.title} description={meta.description} canonical={meta.canonical} jsonLd={courseJsonLd}>
  {/* §1 Hero */}
  <section class="py-20 md:py-28 px-6" style="background-color:hsl(var(--eden-cream))">
    <div class="max-w-4xl mx-auto text-center">
      <p class="font-accent text-sm tracking-[0.3em] uppercase mb-6" style="color:hsl(var(--eden-gold))">Eden's Table</p>
      <h1 class="font-serif text-4xl md:text-5xl lg:text-6xl font-bold leading-tight mb-6" style="color:hsl(var(--eden-bark))">
        Herbalism for the<br /><span class="italic">Whole Family Table.</span>
      </h1>
      <div class="w-16 h-px mx-auto my-8" style="background-color:hsl(var(--eden-gold))"></div>
      <p class="font-body text-lg text-muted-foreground max-w-2xl mx-auto mb-6 leading-relaxed">
        A K-12 Biblical herbalism curriculum for homeschool families. Open-and-go lesson plans, memory songs, kitchen labs, garden activities, and a recurring family story — rooted in Scripture and creation stewardship.
      </p>
      <p class="font-accent text-sm tracking-wider uppercase mb-8" style="color:hsl(var(--eden-sage))">
        Sprouts (K-2) + Seedlings (3-5) · Free sample weeks — sent to your inbox today
      </p>
      <div id="early-access" class="flex flex-col items-center gap-4 scroll-mt-28">
        <p class="font-accent text-xs tracking-[0.3em] uppercase" style="color:hsl(var(--eden-gold))">
          Start free — two real weeks, yours to print and teach today
        </p>
        <DualLeadMagnetCTAs size="xl" variant="eden" />
        <p class="font-body text-sm text-muted-foreground max-w-md mx-auto mt-1">
          Five full lessons per week — Teacher Guide, Student Notebook, Field Cards, Recipe Cards, and Around-the-Table deck. Delivered to your email instantly, free.
        </p>
        <p class="mt-4 font-accent text-xs tracking-[0.2em] uppercase" style="color:hsl(var(--eden-sage))">
          Full curriculum preorder opens July 29
        </p>
      </div>
    </div>
  </section>

  {/* §2 Four Grade Bands */}
  <section class="py-16 px-6 bg-background">
    <div class="max-w-5xl mx-auto">
      <div class="text-center mb-12">
        <h2 class="font-serif text-3xl font-bold mb-4" style="color:hsl(var(--eden-bark))">Four Grade Bands. One Family Vision.</h2>
        <p class="font-body text-muted-foreground max-w-2xl mx-auto">Eden's Table grows with your children — from wonder-filled kitchen labs to clinical reasoning in high school.</p>
      </div>
      <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-5">
        <div class="rounded-lg p-6 border-2" style="border-color:hsl(var(--eden-gold));background-color:hsl(var(--eden-cream))">
          <Sprout className="w-6 h-6 mb-3" color="hsl(var(--eden-gold))" />
          <h3 class="font-serif text-lg font-bold mb-1" style="color:hsl(var(--eden-bark))">Sprouts</h3>
          <p class="font-accent text-xs tracking-widest uppercase mb-3" style="color:hsl(var(--eden-gold))">Grades K-2</p>
          <p class="font-body text-sm text-muted-foreground mb-4 leading-relaxed">Wonder, stories, and simple plant identification. Kitchen labs and memory songs.</p>
          <span class="text-xs font-body px-2 py-1 rounded" style="background-color:hsl(var(--eden-gold) / 0.15);color:hsl(var(--eden-gold))">Preorder opens July 29</span>
        </div>
        <div class="rounded-lg p-6 border-2" style="border-color:hsl(var(--eden-gold));background-color:hsl(var(--eden-cream))">
          <BookOpen className="w-6 h-6 mb-3" color="hsl(var(--eden-gold))" />
          <h3 class="font-serif text-lg font-bold mb-1" style="color:hsl(var(--eden-bark))">Seedlings</h3>
          <p class="font-accent text-xs tracking-widest uppercase mb-3" style="color:hsl(var(--eden-gold))">Grades 3-5</p>
          <p class="font-body text-sm text-muted-foreground mb-4 leading-relaxed">Body systems basics, herb profiles, and family dinner discussions.</p>
          <span class="text-xs font-body px-2 py-1 rounded" style="background-color:hsl(var(--eden-gold) / 0.15);color:hsl(var(--eden-gold))">Coming after Sprouts</span>
        </div>
        <div class="rounded-lg p-6 border opacity-75" style="border-color:hsl(var(--border))">
          <BookOpen className="w-6 h-6 mb-3 text-muted-foreground" />
          <h3 class="font-serif text-lg font-bold mb-1" style="color:hsl(var(--eden-bark))">Cultivators</h3>
          <p class="font-accent text-xs tracking-widest uppercase mb-3 text-muted-foreground">Grades 6-8</p>
          <p class="font-body text-sm text-muted-foreground mb-4 leading-relaxed">Body pattern thinking, terrain basics, and garden-to-remedy workflows.</p>
          <span class="text-xs font-body px-2 py-1 rounded bg-muted text-muted-foreground">Launches after 2027</span>
        </div>
        <div class="rounded-lg p-6 border opacity-75" style="border-color:hsl(var(--border))">
          <Users className="w-6 h-6 mb-3 text-muted-foreground" />
          <h3 class="font-serif text-lg font-bold mb-1" style="color:hsl(var(--eden-bark))">Practitioners</h3>
          <p class="font-accent text-xs tracking-widest uppercase mb-3 text-muted-foreground">Grades 9-12</p>
          <p class="font-body text-sm text-muted-foreground mb-4 leading-relaxed">Clinical literacy, materia medica, and real-world application.</p>
          <span class="text-xs font-body px-2 py-1 rounded bg-muted text-muted-foreground">Launches after 2028</span>
        </div>
      </div>
    </div>
  </section>

  {/* §3 Three Pillars */}
  <section class="py-16 px-6" style="background-color:hsl(var(--eden-forest))">
    <div class="max-w-4xl mx-auto text-center">
      <h2 class="font-serif text-3xl font-bold mb-6 text-white">Open-and-Go. Family-Style. Faith-Rooted.</h2>
      <div class="grid md:grid-cols-3 gap-6 text-left mt-8">
        <div class="rounded-lg p-6" style="background-color:rgba(255,255,255,0.08)">
          <h3 class="font-serif text-lg font-semibold mb-3 text-white">No Prep Required</h3>
          <p class="font-body text-sm leading-relaxed" style="color:rgba(255,255,255,0.75)">Every lesson includes a parent guide, student workbook, kitchen lab card, and garden activity card. Open and teach.</p>
        </div>
        <div class="rounded-lg p-6" style="background-color:rgba(255,255,255,0.08)">
          <h3 class="font-serif text-lg font-semibold mb-3 text-white">Multi-Age by Design</h3>
          <p class="font-body text-sm leading-relaxed" style="color:rgba(255,255,255,0.75)">Lessons are written for the whole family to learn together. Older students go deeper; younger ones grow into it.</p>
        </div>
        <div class="rounded-lg p-6" style="background-color:rgba(255,255,255,0.08)">
          <h3 class="font-serif text-lg font-semibold mb-3 text-white">Scripture Throughout</h3>
          <p class="font-body text-sm leading-relaxed" style="color:rgba(255,255,255,0.75)">Every unit anchored in Scripture. Herbalism presented as stewardship of Yahweh's creation, not alternative medicine.</p>
        </div>
      </div>
    </div>
  </section>

  {/* §4-§9 Component showcases — band-agnostic copy, one or two images each */}
  {SHOWCASES.map((s, idx) => (
    <section id={`showcase-${s.id}`} class="py-16 md:py-20 px-6" style={`background-color:${idx % 2 === 0 ? "hsl(var(--background))" : "hsl(var(--eden-cream) / 0.4)"}`}>
      <div class="max-w-6xl mx-auto">
        <div class="text-center mb-10">
          <p class="font-accent text-sm tracking-[0.3em] uppercase mb-3" style="color:hsl(var(--eden-gold))">{s.eyebrow}</p>
          <h2 class="font-serif text-3xl md:text-4xl font-bold" style="color:hsl(var(--eden-bark))">{s.title}</h2>
        </div>
        <div class={`grid items-start gap-4 md:gap-6 mb-8 ${s.insideSrc ? "md:grid-cols-2" : "max-w-xl mx-auto"}`}>
          <div class="rounded-lg overflow-hidden bg-white shadow-sm">
            <img src={s.src} alt={s.alt} loading="lazy" width="1024" height="1024" class="w-full h-auto" />
          </div>
          {s.insideSrc && (
            <div>
              <div class="rounded-lg overflow-hidden bg-white shadow-sm">
                <img src={s.insideSrc} alt={s.insideAlt} loading="lazy" width={s.insideW} height={s.insideH} class="w-full h-auto" />
              </div>
              <p class="font-accent text-xs tracking-[0.25em] uppercase mt-2 text-center" style="color:hsl(var(--eden-gold))">{s.insideLabel}</p>
            </div>
          )}
        </div>
        <div class="max-w-3xl mx-auto mb-8 text-center rounded-lg p-6" style="background-color:hsl(var(--eden-cream));border:1px solid hsl(var(--eden-gold) / 0.3)">
          <p class="font-accent text-xs tracking-[0.25em] uppercase mb-2" style="color:hsl(var(--eden-gold))">Sprouts K-2 and Seedlings 3-5</p>
          <p class="font-serif text-lg italic" style="color:hsl(var(--eden-bark))">{s.deepens}</p>
        </div>
        <p class="font-body text-base md:text-lg max-w-3xl mx-auto leading-relaxed text-foreground mb-8 text-center">{s.body}</p>
        <blockquote class="font-serif text-xl italic text-center mb-10 max-w-2xl mx-auto" style="color:hsl(var(--eden-bark))">“{s.quote}”</blockquote>
        <DualLeadMagnetCTAs />
      </div>
    </section>
  ))}

  {/* §9.4 The complete kit — the six components as one purchase */}
  <section id="showcase-kit" class="py-16 md:py-20 px-6" style="background-color:hsl(var(--eden-forest))">
    <div class="max-w-6xl mx-auto">
      <div class="text-center mb-10">
        <p class="font-accent text-sm tracking-[0.3em] uppercase mb-3" style="color:hsl(var(--eden-gold))">The Complete Kit</p>
        <h2 class="font-serif text-3xl md:text-4xl font-bold text-white">Six components. Thirty-six weeks. One box.</h2>
      </div>
      <div class="grid md:grid-cols-2 gap-4 md:gap-6 mb-10">
        <div class="rounded-lg overflow-hidden bg-white shadow-sm">
          <img src={KIT.closedSrc} alt={KIT.closedAlt} loading="lazy" width="1024" height="1024" class="w-full h-auto" />
        </div>
        <div class="rounded-lg overflow-hidden bg-white shadow-sm">
          <img src={KIT.openSrc} alt={KIT.openAlt} loading="lazy" width="1024" height="1024" class="w-full h-auto" />
        </div>
      </div>
      <div class="max-w-3xl mx-auto text-center">
        <p class="font-body text-base md:text-lg leading-relaxed mb-6" style="color:rgba(255,255,255,0.85)">
          One year, thirty-six plants, six components built to work as a single instrument. The Teacher's Guide that means you never prepare the night before. The Student Notebook your child fills in and keeps. The Read-Aloud that gives every week its story. Thirty-six Field Cards, thirty-six Recipe Cards, and one hundred forty-four Around the Table questions.
        </p>
        <p class="font-body text-base md:text-lg leading-relaxed mb-8" style="color:rgba(255,255,255,0.85)">
          Nothing here is filler and nothing is sold to you twice. Each piece does a job the others cannot. The story makes it memorable, the guide makes it teachable, the notebook makes it your child's own, and the cards carry it outdoors, into the kitchen, and to the dinner table. Bought separately, this would be six decisions and six gambles on whether the pieces fit together. They fit because they were designed together, week by week, as one year.
        </p>
        <blockquote class="font-serif text-xl md:text-2xl italic mb-8 text-white">
          “You are not buying a stack of books. You are buying the shape of your family's next school year.”
        </blockquote>
        <p class="font-body text-sm mb-2" style="color:rgba(255,255,255,0.7)">
          Each kit includes one Student Notebook. Additional notebooks are sold separately, so every child in your family can keep a book of their own.
        </p>
        <p class="font-body text-sm mb-8" style="color:rgba(255,255,255,0.7)">
          The herbs themselves are not in the box. Each week uses a small amount of a common dried herb from your pantry, your garden, or the <a href="/homeschool/herbs" class="underline" style="color:hsl(var(--eden-gold))">herb list we keep for you</a>, so nothing in your kit ever expires.
        </p>
        <DualLeadMagnetCTAs />
      </div>
    </div>
  </section>

  {/* §9.45 Mockup disclaimer — nothing is printed yet; these are design mockups */}
  <section class="py-10 px-6 bg-background">
    <div class="max-w-3xl mx-auto text-center rounded-lg p-6 border" style="border-color:hsl(var(--eden-gold) / 0.3);background-color:hsl(var(--eden-cream) / 0.4)">
      <p class="font-accent text-xs tracking-[0.25em] uppercase mb-2" style="color:hsl(var(--eden-gold))">About these images</p>
      <p class="font-body text-sm text-muted-foreground leading-relaxed">
        The product photographs on this page are design mockups, created from the real curriculum files ahead of the first print run. They represent the size, binding, materials, and layout of what will arrive at your door. Final printed pieces may differ in small details.
      </p>
    </div>
  </section>

  {/* §9.5 Herb sourcing — links to the parent herb-ordering page */}
  <section class="py-14 px-6 bg-background">
    <div class="max-w-3xl mx-auto text-center rounded-lg p-8 md:p-10 border" style="border-color:hsl(var(--eden-gold) / 0.3);background-color:hsl(var(--eden-cream) / 0.5)">
      <p class="font-accent text-sm tracking-[0.3em] uppercase mb-3" style="color:hsl(var(--eden-gold))">Already teaching?</p>
      <h2 class="font-serif text-2xl md:text-3xl font-bold mb-3" style="color:hsl(var(--eden-bark))">Order the herbs for every lesson.</h2>
      <p class="font-body text-muted-foreground max-w-xl mx-auto mb-6 leading-relaxed">
        Every herb your family studies, with a trusted source for each one. We have gathered the full Sprouts herb list in one place so you can stock your shelf for the year.
      </p>
      <a href="/homeschool/herbs">
        <Button variant="eden" size="xl">Purchase Herbs Here</Button>
      </a>
    </div>
  </section>

  {/* §10 Pricing & preorder */}
  <section id="pricing" class="py-20 md:py-24 px-6" style="background-color:hsl(var(--eden-cream))">
