---
// /homeschool — Astro port of src/pages/Homeschool.tsx. Pre-rendered to static
// HTML for SEO (the page's whole reason for existing). 2026-07-25: the page
// became a single-offer preorder page and lost its lead-magnet capture.
// 2026-09-11: it became the hub again (founder direction), with every band and
// every way in on one page. 2026-09-12: the preorder buy box came off with the
// print-first pivot (see the §10 comment). Island: WaitlistController for the
// free-week and "tell me when" modals.
import MarketingLayout from "../layouts/MarketingLayout.astro";
// Hero watermark: public domain botanical plate from Koehler's Medizinal-Pflanzen
// (1887), desaturated to a sage wash and feathered at the edges, matching the
// watermark treatment in the Sprouts Student Notebook. Rendered at 95% opacity
// behind a white content panel (PR #433, full-colour botanicals) with
// mix-blend-mode:multiply, so the white ground vanishes and only the plant tints
// the section. The image is 1920x1080 to match the hero aspect; do not swap in a
// portrait plate, it will crop to a band across the middle of the plant.
import heroHomeschool from "@/assets/hero-homeschool.jpg";
import { Button, buttonVariants } from "@/components/ui/button";
import { cn } from "@/lib/utils";
// CTA links carry buttonVariants classes rather than wrapping a <Button>: a
// <button> inside an <a> is invalid HTML and a second tab stop. text-center
// stands in for a <button>'s own centring; max-md:w-full max-md:max-w-full keep
// the full-width phone layout src/index.css gives `section button`; and where the
// inner button used h-full to fill its stretched wrapper, the link takes h-auto.
import WaitlistController from "../components/islands/WaitlistController.tsx";
import PayOverTime from "../components/islands/PayOverTime.tsx";
import ComponentShowcases from "../components/ComponentShowcases.astro";
import BandChooser from "../components/BandChooser.astro";

const meta = {
  title: "Christian Homeschool Herbalism Curriculum, Grades K-5 | Eden's Table",
  description:
    "A Christ-centered homeschool herbalism curriculum, one plant a week. Sprouts (K-2) and Seedlings (3-5) are both available now: a free week, a $39 Starter Unit, or the full 36-week printed set. Cultivators and Practitioners are next.",
  canonical: "https://edeninstitute.health/homeschool",
};

// Course structured data — baked statically into the page <head> (was injected
// at runtime via useEffect in the React version, so crawlers never saw it).
const courseJsonLd = {
  "@context": "https://schema.org",
  "@type": "Course",
  name: "Eden's Table: Christian Homeschool Herbalism Curriculum",
  description:
    "A Christ-centered, Scripture-anchored K-5 homeschool curriculum teaching herbalism and the body God designed. Open-and-go weekly lessons for Sprouts (K-2) and Seedlings (3-5).",
  url: "https://edeninstitute.health/homeschool",
  inLanguage: "en",
  educationalLevel: "Elementary school (K-5)",
  about: ["Christian homeschool curriculum", "Biblical herbalism", "Faith-based science", "creation stewardship"],
  provider: { "@type": "Organization", name: "The Eden Institute", url: "https://edeninstitute.health" },
  audience: { "@type": "EducationalAudience", educationalRole: "homeschooling family" },
};

// 2026-07-25 the lead-magnet capture was removed; 2026-09-11 the hub restored a
// free Week 1 path via /freebies and WaitlistController.

// Component showcases live in web/components/ComponentShowcases.astro since
// 2026-09-11, so /books and /starter show the same component story with the
// same polished photos. Do not add a copy here.

// THE HUB DATA. One entry per band, rebuilt 2026-09-11 (founder direction:
// everything lands on /homeschool, a band strip up top, four options per band).
//
// Prices here are display copy. Billing truth lives in Stripe via
// create-checkout: kit 24900 founding / 34900 retail (order-config.ts), Starter
// Unit 3900 (starter-config.ts), printed set 24900 (products table). Change a
// price there first, then here.
//
// Launch timing for the later bands is the founder's stated plan, 2026-09-11:
// Cultivators late 2027, Practitioners 2028. Neither has a product; both get a
// "tell me when" capture whose source tag is stored so the list can be
// segmented later. Seedlings went fully on sale 2026-09-24 (free week, $39
// Starter, $249 printed set), the same three rungs as Sprouts.
interface Rung {
  step: string;
  title: string;
  price: string;
  /** Retail price shown crossed out beside the founding price. */
  was?: string;
  points: string[];
  when: string;
  button?: string;
  href?: string;
  cta?: string;
  primary?: boolean;
  soon?: boolean;
  modal?: { source: string; title: string; subtitle: string };
}
interface Band {
  id: "sprouts" | "seedlings" | "cultivators" | "practitioners";
  name: string;
  grades: string;
  status: string;
  live: boolean;
  blurb: string;
  rungs?: Rung[];
  planned?: string[];
}

const BANDS: Band[] = [
  {
    id: "sprouts",
    name: "Sprouts",
    grades: "Grades K-2",
    status: "Available now",
    live: true,
    blurb: "Wonder, stories, and learning 36 plants by sight. Kitchen labs, memory songs, and a family at the center of every week. This is where every child starts, even the older ones.",
    rungs: [
      {
        step: "Step 1 · Try it",
        title: "Week 1, free",
        price: "$0",
        points: ["Five full lessons on Lavender", "Teacher's Guide, Notebook and story, as PDFs", "In your inbox in a minute"],
        when: "Print it and teach it today.",
        button: "Get Week 1 free",
        cta: "homeschool-sprouts-free",
        modal: {
          source: "sprouts_magnet",
          title: "Get Sprouts Week 1 · Free",
          subtitle: "Check your inbox. Your free Sprouts Week 1 (Lavender) downloads are on their way right now. Five real lessons, the Teacher's Guide, the Notebook and the story, to print and teach today.",
        },
      },
      {
        step: "Step 2 · Start now",
        title: "Starter Unit, weeks 1 to 9",
        price: "$39",
        points: ["The 9-week starter: weeks 1 to 9 of 36", "Teacher's Guide, Notebook and storybook", "Instant download"],
        when: "Tonight. It downloads to your inbox in about a minute.",
        button: "Get the Starter Unit",
        href: "/starter",
        cta: "homeschool-sprouts-starter",
      },
      {
        step: "Step 3 · The whole year, in print",
        title: "Printed Curriculum Set",
        price: "$249",
        points: ["All 36 weeks, three printed books", "Teacher's Guide, Notebook, storybook", "Extra Notebooks for siblings, $39.99 each", "Printed to order, mailed to you"],
        when: "At your door in about 2 to 3 weeks.",
        button: "Order the printed set",
        href: "/books",
        cta: "homeschool-sprouts-books",
        primary: true,
      },
    ],
  },
  {
    id: "seedlings",
    name: "Seedlings",
    grades: "Grades 3-5",
    status: "Available now",
    live: true,
    blurb: "Body systems, herb profiles, a hypothesis tracked across a week, and dinner-table questions with real reasoning in them. A different 36 plants from Sprouts, so a family who does both finishes with 72.",
    rungs: [
      {
        step: "Step 1 · Try it",
        title: "Week 1, free",
        price: "$0",
        points: ["Five full lessons on Elderberry", "Teacher's Guide and Notebook, plus Story Seven, as PDFs", "In your inbox in a minute"],
        when: "Print it and teach it today.",
        button: "Get Week 1 free",
        cta: "homeschool-seedlings-free",
        modal: {
          source: "seedlings_magnet",
          title: "Get Seedlings Week 1 · Free",
          subtitle: "Check your inbox. Your free Seedlings Week 1 (Elderberry) downloads are on their way right now. Five real lessons, the Teacher's Guide and the Notebook, to print and teach today.",
        },
      },
      // Buyable since 2026-09-23 (founder decision): same shape as the Sprouts rung.
      {
        step: "Step 2 · Start now",
        title: "Starter Unit, weeks 1 to 9",
        price: "$39",
        points: ["The 9-week starter: weeks 1 to 9 of 36", "Teacher's Guide, Notebook and storybook", "Instant download"],
        when: "Tonight. It downloads to your inbox in about a minute.",
        button: "Get the Starter Unit",
        href: "/starter/seedlings",
        cta: "homeschool-seedlings-starter",
      },
      // On sale since 2026-09-24 (founder: "turn on the print set"), the /books #seedlings buy box.
      {
        step: "Step 3 · The whole year, in print",
        title: "Printed Curriculum Set",
        price: "$249",
        points: ["All 36 weeks, three printed books", "Teacher's Guide, Notebook, storybook", "Extra Notebooks for siblings, $39.99 each", "Printed to order, mailed to you"],
        when: "At your door in about 2 to 3 weeks.",
        button: "Order the printed set",
        href: "/books#seedlings",
        cta: "homeschool-seedlings-books",
        primary: true,
      },
    ],
  },
  {
    id: "cultivators",
    name: "Cultivators",
    grades: "Grades 6-8",
    status: "Planned for late 2027",
    live: false,
    blurb: "The second pass at the 72 plants your child already knows, this time through body patterns and terrain: why the same plant helps one person and not another, and how a garden becomes a remedy.",
    planned: [
      "Revisits all 72 Sprouts and Seedlings plants at a deeper level, so nothing learned is wasted",
      "Body pattern thinking and the basics of terrain",
      "Garden to remedy: growing, harvesting, drying and preparing, start to finish",
      "Same shape as the earlier bands, written for a middle schooler who wants the why",
    ],
  },
  {
    id: "practitioners",
    name: "Practitioners",
    grades: "Grades 9-12",
    status: "Planned for 2028",
    live: false,
    blurb: "The third pass at the 72 plants, at clinical depth. A high schooler who has grown up with these plants learns to reason about them the way a practitioner does.",
    planned: [
      "The 72 plants a third time, now as materia medica",
      "Clinical literacy: reading a body, matching a plant to a pattern, knowing when to refer",
      "Real-world application, the kind that outlasts the diploma",
      "Same shape as the earlier bands, written for a teenager ready for real responsibility",
    ],
  },
];

// The printed-year section (§9.4) — the three books as one purchase.
// 2026-09-12: the kit box photo (ET_Kit_Open.webp) came out with the kit itself.
// The file stays in public/showcases for phase two.
const PRINT_SET = {
  setSrc: "/showcases/ET_PrintSet.webp",
  setAlt: "The three printed Sprouts books, the Teacher's Guide, Student Notebook and Read-Aloud Storybook, on a linen cloth",
};
---

<MarketingLayout title={meta.title} description={meta.description} canonical={meta.canonical} jsonLd={courseJsonLd}>
  {/* §1 Hero */}
  {/* Mobile spacing here is MEASURED, not eyeballed. On a 375x812 phone the
      original hero pushed the credit line to y=816, i.e. the one sentence that
      explains why both buttons exist started below the fold. Every md: prefix
      below preserves the desktop look while buying that line back on mobile.
      If you edit this hero, re-measure it. */}
  <section class="relative overflow-hidden py-12 md:py-28 px-6" style="background-color:hsl(var(--eden-cream))">
    <img src={heroHomeschool.src} alt="" aria-hidden="true" class="absolute inset-0 w-full h-full object-cover pointer-events-none select-none" style="opacity:0.95;mix-blend-mode:multiply" />
    <div class="relative z-10 max-w-4xl mx-auto text-center rounded-lg" style="background-color:hsl(0 0% 100% / 0.92);border:1px solid hsl(var(--eden-gold) / 0.35);padding:clamp(26px, 3.5vw, 52px);box-shadow:0 2px 18px -10px rgba(30,62,46,0.28)">
      <p class="font-accent text-sm tracking-[0.3em] uppercase mb-4 md:mb-6" style="color:hsl(var(--eden-gold-ink))">Eden's Table</p>
      <h1 class="font-serif text-4xl md:text-5xl lg:text-6xl font-bold leading-tight mb-4 md:mb-6" style="color:hsl(var(--eden-bark))">
        Herbalism for the<br /><span class="italic">Whole Family Table.</span>
      </h1>
      <div class="w-16 h-px mx-auto my-5 md:my-8" style="background-color:hsl(var(--eden-gold-ink))"></div>
      <p class="font-body text-base md:text-lg text-muted-foreground max-w-2xl mx-auto mb-4 md:mb-6 leading-relaxed" style="color:hsl(var(--eden-bark))">
        A Biblical herbalism curriculum for K-5 homeschool families, with grades 6 to 12 to follow. Open-and-go lesson plans, memory songs, kitchen labs, garden activities, and a recurring family story, all rooted in Scripture and creation stewardship.
      </p>
      <p class="font-accent text-sm tracking-wider uppercase mb-5 md:mb-8" style="color:hsl(var(--eden-sage-ink))">
        Sprouts (K-2) and Seedlings (3-5) · Two complete 36-week years, in print or 9 weeks at a time
      </p>
      {/* id="early-access" is load-bearing: the homepage links to
          /homeschool#early-access (index.astro). Keep it even though the
          lead-magnet capture that originally lived here is gone. */}
      <div id="early-access" class="flex flex-col items-center gap-4 scroll-mt-28 min-[1024px]:scroll-mt-40">
        {/* TWO doors, founder direction 2026-09-12. The kit came off the site
            with the print-first pivot, so the printed year leads and the $39 is
            the outlined try-it door. The kit button, its copy and its buy box are
            in git history on b8751c1 for phase two. */}
        <div class="grid gap-3 sm:grid-cols-2 sm:gap-4 w-full max-w-xl">
          <a href="/books" data-cta="homeschool-hero-books" class={cn(buttonVariants({ variant: "eden", size: "xl" }), "text-center w-full h-auto flex-col whitespace-normal text-sm sm:text-base leading-snug min-h-[48px] py-3 px-4")}>
            <span class="block">Get the printed year now</span>
            <span class="block mt-1 whitespace-nowrap">$249</span>
            <span class="block mt-1 text-[11px] sm:text-xs font-normal normal-case tracking-normal opacity-85">All 36 weeks. At your door in about 2 to 3 weeks.</span>
          </a>
          <a href="#choose-band" data-cta="homeschool-hero-starter" class={cn(buttonVariants({ variant: "eden-outline", size: "xl" }), "text-center w-full h-auto flex-col whitespace-normal text-sm sm:text-base leading-snug min-h-[48px] py-3 px-4")}>
            <span class="block">Try 9 weeks digital</span>
            <span class="block mt-1 whitespace-nowrap">$39</span>
            <span class="block mt-1 text-[11px] sm:text-xs font-normal normal-case tracking-normal opacity-85">Instant download. Teach it tonight.</span>
          </a>
        </div>

        {/* One line per door, so a reader skimming can take the meaning from
            here without reading the rest of the page. */}
        <p class="font-body text-sm max-w-2xl mx-auto mt-1 leading-relaxed" style="color:hsl(var(--eden-bark))">
          <strong>The printed year</strong> is the whole 36 weeks in three books, printed to order
          and at your door in about two to three weeks. <strong>The Starter Unit</strong> is the first nine
          weeks of it, as a download, if you would rather try before you commit.
        </p>

        <p class="font-body text-sm text-muted-foreground max-w-md mx-auto">
          Flat $12 shipping per printed order. Extra Student Notebooks for siblings, Sprouts or Seedlings, $39.99 each.
        </p>

        {/* Stripe's pay-over-time line for the printed set. 24900 mirrors the $249 above. */}
        <PayOverTime client:only="react" amountCents={24900} align="center" className="max-w-md mx-auto w-full" />

        <a href="#choose-band" data-cta="homeschool-hero-bands" class="font-body text-sm underline underline-offset-4 mt-3" style="color:hsl(var(--eden-forest))">
          Not sure which band? Find your family in 10 seconds
        </a>
      </div>
    </div>
  </section>

  {/* CRO 2026-09-24: both elementary bands and the "where do we start" answer,
      directly under the hero, where the grade question forms. */}
  <BandChooser ctaPrefix="homeschool" />

  {/* §1.5 Why buy an herbalism curriculum (copy doc Section 1) */}
  <section class="py-16 md:py-20 px-6 bg-background">
    <div class="max-w-5xl mx-auto">
      <div class="text-center mb-10">
        <p class="font-accent text-sm tracking-[0.3em] uppercase mb-3" style="color:hsl(var(--eden-gold-ink))">Why this. Why now.</p>
        <h2 class="font-serif text-3xl md:text-4xl font-bold leading-tight" style="color:hsl(var(--eden-bark))">
          School will teach her the parts of a flower.<br />It will not teach her what the flower is for.
        </h2>
      </div>

      <div class="grid md:grid-cols-2 gap-8 items-center mb-12">
        <div class="font-body text-base md:text-lg leading-relaxed text-foreground space-y-4">
          <p>I spent years as a credentialed classroom teacher with a Master's in education. I know what is in the standards, and I know what is not. Somewhere in there a child learns to label a stem, a root, and a petal. Nowhere in there does a child learn what to reach for when her throat hurts, what is happening inside her body while it heals, or why any of it was put here in the first place.</p>
          <p class="font-serif text-lg italic" style="color:hsl(var(--eden-bark))">That is not a small gap. That is the entire practical use of the subject, left out.</p>
        </div>
        <div>
          <div class="rounded-lg overflow-hidden bg-white shadow-sm border" style="border-color:hsl(var(--eden-gold) / 0.3)">
            <img src="/showcases/ET_WeekAtAGlance.png" alt="Week 5 of the Sprouts Teacher's Guide, showing the calendula week laid out Monday through Friday with the scripture, the kitchen lab supply list, and the subjects woven through the week." loading="lazy" width="1275" height="1650" class="w-full h-auto" />
          </div>
          <p class="font-accent text-xs tracking-[0.25em] uppercase mt-2 text-center" style="color:hsl(var(--eden-gold-ink))">One real week, exactly as it arrives · Week 5 · Calendula</p>
        </div>
      </div>

      <div class="grid md:grid-cols-3 gap-6">
        <div class="rounded-lg p-6" style="background-color:hsl(var(--eden-cream))">
          <h3 class="font-serif text-lg font-bold mb-3" style="color:hsl(var(--eden-bark))">Health stewardship is not a hobby subject.</h3>
          <p class="font-body text-sm leading-relaxed text-muted-foreground">Your child is going to live in one body for the whole of her life. She will make decisions about it every single day, starting long before she is grown. Teaching her to understand it, care for it, and pay attention to what it is telling her is not enrichment. It is one of the more practical things you will ever hand her, and we treat it that way, as a subject with a scope, a sequence, and a full year of work.</p>
        </div>
        <div class="rounded-lg p-6" style="background-color:hsl(var(--eden-cream))">
          <h3 class="font-serif text-lg font-bold mb-3" style="color:hsl(var(--eden-bark))">One plant a week. Ten subjects come with it.</h3>
          <p class="font-body text-sm leading-relaxed text-muted-foreground">This is not herbalism bolted onto your existing school day. A single week on a single plant carries Bible, science, language arts, math, art, history, geography, Latin, health, and character, and the Week at a Glance page tells you which day carries which. You are not stacking ten subjects into a morning. You are teaching one plant well, and the disciplines arrive with it.</p>
        </div>
        <div class="rounded-lg p-6" style="background-color:hsl(var(--eden-cream))">
          <h3 class="font-serif text-lg font-bold mb-3" style="color:hsl(var(--eden-bark))">The year your children are in is the one you have.</h3>
          <p class="font-body text-sm leading-relaxed text-muted-foreground">Sprouts (K-2) and Seedlings (3-5) are both in print now. Cultivators and Practitioners follow them. A child who starts this year grows through the whole sequence with us. A child who waits starts it a year older, in a year we cannot give back.</p>
        </div>
      </div>

      <div class="text-center mt-10">
        <a href="/books" data-cta="homeschool-why-books" class={cn(buttonVariants({ variant: "eden", size: "xl" }), "text-center max-md:w-full max-md:max-w-full")}>Order the printed year · $249</a>
        <p class="font-body text-xs text-muted-foreground mt-3">All 36 weeks in three books. Flat $12 shipping.</p>
      </div>
    </div>
  </section>

  {/* §2 THE FOUR BANDS AND WHAT EACH ONE OFFERS. Rebuilt 2026-09-11 (founder
      direction): /homeschool is the hub. A band strip up top jumps to the band a
      parent needs; each band shows its whole ladder in four columns so the
      choice is visible in one glance: free week, $39 Starter, $249 printed set.
      The fourth rung was the $249 kit until the print-first pivot on 2026-09-12.
      The deep pages (/freebies, /starter, /books) stay where they are and the
      cards link to them; sent emails still point at them.
      Later bands show what is planned and when, with one "tell me when" button. */}
  <section id="bands" class="py-14 md:py-20 px-6 bg-background scroll-mt-24 min-[1024px]:scroll-mt-36">
    <div class="max-w-6xl mx-auto">
      <div class="text-center mb-8">
        <p class="font-accent text-sm tracking-[0.3em] uppercase mb-3" style="color:hsl(var(--eden-gold-ink))">Four grade bands</p>
        <h2 class="font-serif text-3xl md:text-4xl font-bold mb-3" style="color:hsl(var(--eden-bark))">Find your children's band. Then pick how you want to start.</h2>
        <p class="font-body text-muted-foreground max-w-2xl mx-auto">Sprouts and Seedlings each teach their own 36 plants, and Cultivators and Practitioners come back to all 72 at a deeper level. A child who starts in Sprouts grows through all four with us.</p>
      </div>

      {/* Band strip. Plain anchor links, so it works with no JS and on any phone. */}
      <nav aria-label="Grade bands" class="grid grid-cols-2 lg:grid-cols-4 gap-3 mb-12">
        {BANDS.map((b) => (
          <a href={`#${b.id}`} class="rounded-lg p-4 border-2 text-left transition-colors hover:bg-white" style={`border-color:${b.live ? "hsl(var(--eden-gold))" : "hsl(var(--border))"};background-color:${b.live ? "hsl(var(--eden-cream))" : "transparent"}`}>
            <p class="font-serif text-lg font-bold" style="color:hsl(var(--eden-bark))">{b.name}</p>
            <p class="font-accent text-xs tracking-widest uppercase mb-2" style={`color:${b.live ? "hsl(var(--eden-gold-ink))" : "hsl(var(--muted-foreground))"}`}>{b.grades}</p>
            <span class="text-xs font-body px-2 py-1 rounded inline-block" style={b.live ? "background-color:hsl(var(--eden-gold) / 0.15);color:hsl(var(--eden-gold-ink))" : "background-color:hsl(var(--muted));color:hsl(var(--muted-foreground))"}>{b.status}</span>
          </a>
        ))}
      </nav>

      {/* One ladder per band. */}
      <div class="space-y-14">
        {BANDS.map((b) => (
          <div id={b.id} class="scroll-mt-24 min-[1024px]:scroll-mt-36">
            <div class="flex flex-col md:flex-row md:items-end md:justify-between gap-3 mb-6">
              <div>
                <p class="font-accent text-xs tracking-[0.25em] uppercase mb-1" style="color:hsl(var(--eden-gold-ink))">{b.grades}</p>
                <h3 class="font-serif text-2xl md:text-3xl font-bold" style="color:hsl(var(--eden-bark))">{b.name}</h3>
                <p class="font-body text-sm md:text-base text-muted-foreground mt-2 max-w-2xl leading-relaxed">{b.blurb}</p>
              </div>
              {!b.live && (
                <span class="text-xs font-body px-3 py-1.5 rounded self-start md:self-auto" style="background-color:hsl(var(--muted));color:hsl(var(--muted-foreground))">{b.status}</span>
              )}
            </div>

            {b.rungs ? (
              <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-4">
                {b.rungs.map((r) => (
                  <div class={`rounded-lg p-5 border-2 flex flex-col ${r.soon ? "opacity-80" : ""}`} style={`border-color:${r.soon ? "hsl(var(--border))" : "hsl(var(--eden-gold) / 0.6)"};background-color:${r.soon ? "transparent" : "hsl(var(--eden-cream))"}`}>
                    <p class="font-accent text-[10px] tracking-[0.25em] uppercase mb-2" style="color:hsl(var(--eden-gold-ink))">{r.step}</p>
                    <h4 class="font-serif text-lg font-bold leading-snug" style="color:hsl(var(--eden-bark))">{r.title}</h4>
                    {r.price && <p class="font-serif text-2xl font-bold my-2" style="color:hsl(var(--eden-forest))">{r.price}</p>}
                    <ul class="font-body text-sm text-muted-foreground space-y-1 mb-3">
                      {r.points.map((pt) => <li>{pt}</li>)}
                    </ul>
                    <p class="font-body text-xs font-bold mb-4 mt-auto" style="color:hsl(var(--eden-bark))">{r.when}</p>
