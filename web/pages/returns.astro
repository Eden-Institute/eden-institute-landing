---
// /returns — Return and Refund Policy (ESA vendor readiness). Static Astro
// page linked from every footer. Policy text approved by the founder
// 2026-07-16; copy uses no em dashes.
import MarketingLayout from "../layouts/MarketingLayout.astro";

const meta = {
  title: "Return and Refund Policy · Eden's Table | The Eden Institute",
  description:
    "Return and refund policy for Eden's Table curriculum kits, printed books and student notebooks, published by Rooted in Faith Ventures LLC. 30-day returns on unused physical curriculum; printed-to-order books can be cancelled within 48 hours.",
  canonical: "https://edeninstitute.health/returns",
};

const sections = [
  {
    // Added 2026-07-19. The preorder page promises "cancel for a full refund at any
    // point before your order ships", and this page said nothing about it, so a buyer
    // checking the policy would conclude they were locked in. Same promise, one story.
    heading: "Preorders: closed to new orders, and cancellable any time before they ship",
    body: "We are not taking new preorders. Existing preorders are unchanged and are honored on the terms shown when they were placed. A preorder is charged when you place it, and your kit ships later. Until it ships, you may cancel for a full refund for any reason. Email hello@edeninstitute.health with your order number and we will refund the full amount, including shipping, to your original payment method within 7 working days. You do not need a reason, and there is no fee. If we cannot ship by the guaranteed date shown when you ordered, we will write to you before that date and you may cancel for a full refund then as well.",
  },
  {
    heading: "Boxed kits (existing preorders)",
    body: "This applies to boxed Complete Kits from existing preorders. Printed books are covered separately below. You may request a return within 30 days of delivery. Items must be unused, unmarked, and in original condition with all components included. To start a return, email hello@edeninstitute.health with your order number. Approved refunds are issued to the original payment method within 5 to 10 working days after we receive the returned items. Return shipping is the responsibility of the buyer unless the item arrived damaged or incorrect.",
  },
  {
    // Added 2026-08-26 with the Sprouts Starter Unit. Stated here AND on /starter
    // above the buy button, so a buyer sees it before paying rather than
    // discovering it afterwards. A digital-goods policy that only appears in the
    // delivery email is a policy nobody agreed to.
    heading: "Digital downloads",
    body: "Digital products, including the Eden's Table Starter Unit, are not refundable once the files have been downloaded. This is stated on the product page before purchase. If you have paid but not yet downloaded anything, email hello@edeninstitute.health and we will refund you in full. If a file is corrupt, incomplete, or will not open, tell us and we will fix it or refund you, whichever you prefer. Your download links stay valid for seven days and you can request fresh ones at any time from the link in your delivery email, so a lapsed link is never a reason to buy again.",
  },
  {
    // Added 2026-08-26. The credit is a promise attached to money already spent,
    // so what happens to it if the purchase is reversed has to be written down.
    // 2026-09-13: qualified for scholarship-funded Starters, which the
    // Scholarship and ESA purchases card below excludes.
    heading: "Starter Unit credit toward the Complete Kit",
    body: "Every Sprouts Starter Unit includes a single-use $39 credit toward the Sprouts Complete Kit, unless the Starter Unit was paid with or reimbursed by scholarship funds (see Scholarship and ESA purchases below). The Complete Kit is not currently on sale, so the credit cannot be spent today. It does not expire, and it is honored when the Complete Kit is offered again. The credit is tied to the email address used to buy the Starter Unit and is not transferable. If a Starter Unit purchase is refunded, its credit is cancelled with it. If you use the credit on a kit and later cancel that kit order, we refund what you paid for the kit and reinstate the credit.",
  },
  {
    // Added 2026-09-11 with the printed Sprouts set (/books); covers the Seedlings
    // set too since 2026-09-24 (same print partner, same 48 hours). Each set is
    // printed to order by our print partner, which is why it cannot come back
    // once printing starts. The 48 hours is the print partner's production
    // delay, which the site sets to its maximum on purpose.
    heading: "Printed books, printed to order (the Sprouts and Seedlings sets)",
    body: "Each Sprouts or Seedlings set of the Teacher's Guide, Student Notebook and Read-Aloud storybook is printed just for you when you order, so it cannot be returned once printing has started. You have 48 hours after ordering to cancel or change anything, including the address, for a full refund: reply to your confirmation email with your order number. Printing starts automatically after that. If a book arrives bent, misprinted or damaged, email hello@edeninstitute.health a photo within 14 days of delivery and we will replace it at no cost to you.",
  },
  {
    heading: "Consumable workbooks and notebooks",
    body: "A Student Notebook from a boxed kit is a consumable, write-in product, so it can be returned only if it is unopened and unused. Extra Student Notebooks added to a printed set are printed to order and follow the printed-books policy above.",
  },
  {
    heading: "Damaged or incorrect orders",
    body: "If your order arrives damaged, defective, or incorrect, email hello@edeninstitute.health within 14 days of delivery with your order number and a photo. We will replace the item or issue a full refund, including shipping, at no cost to you.",
  },
  {
    // Added 2026-09-13. Scholarship programs do not allow a vendor to refund or
    // rebate program money to the parent: AZ A.R.S. 15-2402(J); NH CSF EFA Parent
    // Handbook p.31 (back to CSF or ClassWallet within 30 days); WY WDE ESA Family
    // Handbook p.16; AR EFA via ClassWallet. Arizona families may also pay on our
    // own checkout by typing in the ClassWallet-issued ESA debit card number (ADE
    // handbook printed p.48; MCC restrictions can still decline it), so that
    // refund goes back to the same card. Invoice wording is
    // program-neutral: NH and AR say Direct Pay, AZ says Pay Vendor. The $39
    // Starter credit is a rebate on program money when the Starter was
    // program-funded, so it is excluded here.
    heading: "Scholarship and ESA purchases",
    body: "If your order was paid with money from an ESA, EFA or scholarship program, any refund goes back to that program, never to you personally. If you paid on our checkout with a card your program issued, such as an Arizona ESA ClassWallet debit card, the refund goes back to that same card. If you ordered through your program's marketplace, or with an invoice paid through your program, such as Direct Pay or Pay Vendor, the refund goes back to your program account. If your program reimbursed you for an order you placed with us, tell us the order was reimbursed when you ask for a refund, so we can send the money back the way your program requires. The $39 Starter Unit credit does not apply to a Starter Unit that was paid with scholarship funds or reimbursed by a scholarship program.",
  },
];
---

<MarketingLayout title={meta.title} description={meta.description} canonical={meta.canonical}>
  <section class="pt-20 pb-12 px-6" style="background-color:hsl(var(--eden-cream))">
    <div class="max-w-2xl mx-auto text-center">
      <p class="font-accent text-sm tracking-[0.3em] uppercase mb-4" style="color:hsl(var(--eden-gold-ink))">
        Eden's Table
      </p>
      <h1 class="font-serif text-4xl md:text-5xl font-bold leading-tight mb-6" style="color:hsl(var(--eden-bark))">
        Return and Refund Policy
      </h1>
      <div class="w-16 h-px mx-auto my-6" style="background-color:hsl(var(--eden-gold))"></div>
      <p class="font-body text-lg text-muted-foreground leading-relaxed">
        Eden's Table is published by Rooted in Faith Ventures LLC. We want you to be
        confident in your purchase.
      </p>
    </div>
  </section>

  <section class="py-12 px-6 bg-background">
    <div class="max-w-2xl mx-auto space-y-4">
      {sections.map((section) => (
        <div class="rounded-lg p-5 bg-white border" style="border-color:hsl(var(--eden-gold) / 0.3)">
          <h2 class="font-serif text-base font-bold mb-1" style="color:hsl(var(--eden-forest))">{section.heading}</h2>
          <p class="font-body text-sm text-muted-foreground leading-relaxed">{section.body}</p>
        </div>
      ))}
      <div class="rounded-lg p-5 bg-white border" style="border-color:hsl(var(--eden-gold) / 0.3)">
        <h2 class="font-serif text-base font-bold mb-1" style="color:hsl(var(--eden-forest))">Contact</h2>
        <p class="font-body text-sm text-muted-foreground leading-relaxed">
          <a href="mailto:hello@edeninstitute.health" class="underline">hello@edeninstitute.health</a>,
          phone <a href="tel:+19315755895" class="underline">(931) 575-5895</a>, Monday through Friday, 9am to 5pm Central.
        </p>
      </div>
    </div>
  </section>
</MarketingLayout>
