---
// /preorder — PREORDERS CLOSED notice. 2026-09-12, founder decision (the
// print-first pivot): the Sprouts Complete Kit came off the site until the print
// run is funded, and preorders are no longer taken.
//
// WHY THIS PAGE STILL EXISTS instead of a redirect or a 404. Every preorder
// confirmation, every delay notice, the launch and nurture sequences, the podcast
// pitches and the five live buyers' threads all link here. A redirect into /books
// would drop somebody expecting the kit onto a sales page with no explanation, and
// a 404 breaks a year of sent email. So the URL keeps a short honest note.
//
// The full storefront is on b8751c1: the hero, the founding-500 framing, the FTC
// preorder terms, the PreorderBuyBox island, the six ComponentShowcases and the
// ESA product-spec tables (grade/subject/format/SKU/price, which state Education
// Savings Account reviewers look for). Restore it from there for phase two rather
// than rewriting it. /books carries the ESA-facing spec role in the meantime.
//
// The five existing preorders are untouched. They stay on their original terms:
// aiming July 31, 2027, guaranteed on or before September 30, 2027, cancellable
// for a full refund at any point before they ship (/returns).
//
// noindex, because there is nothing here to rank and the page exists only so old
// links land somewhere true.
import MarketingLayout from "../layouts/MarketingLayout.astro";
import { buttonVariants } from "@/components/ui/button";
import { cn } from "@/lib/utils";
// CTA links carry buttonVariants classes rather than wrapping a <Button>: a
// <button> inside an <a> is invalid HTML and a second tab stop. text-center
// stands in for a <button>'s own centring.

const meta = {
  title: "Preorders are closed | Eden's Table",
  description:
    "Preorders are closed. The full 36-week Sprouts printed curriculum is available now.",
  canonical: "https://edeninstitute.health/preorder",
};
---

<MarketingLayout title={meta.title} description={meta.description} canonical={meta.canonical} noindex={true}>
  <section class="py-20 md:py-28 px-6" style="background-color:hsl(var(--eden-cream))">
    <div class="max-w-2xl mx-auto text-center rounded-lg" style="background-color:hsl(0 0% 100% / 0.92);border:1px solid hsl(var(--eden-gold) / 0.35);padding:clamp(26px, 3.5vw, 52px)">
      <p class="font-accent text-sm tracking-[0.3em] uppercase mb-4" style="color:hsl(var(--eden-gold-ink))">Eden's Table</p>
      <h1 class="font-serif text-3xl md:text-4xl font-bold leading-tight mb-5" style="color:hsl(var(--eden-bark))">
        Preorders are closed for now.
      </h1>
      <div class="w-16 h-px mx-auto my-6" style="background-color:hsl(var(--eden-gold-ink))"></div>
      <div class="font-body text-base leading-relaxed space-y-4 text-left" style="color:hsl(var(--eden-bark))">
        <p>
          I stopped taking preorders on the boxed edition. It needs one large print run paid for
          up front, and I am building this without borrowing, so it waits until the money is
          actually there.
        </p>
        <p>
          What is ready is the curriculum itself. All thirty-six weeks of Sprouts are finished and
          printed to order, three books, at your door in about two to three weeks.
        </p>
        <p>
          If you already preordered, nothing about your order has changed and I have written to you
          separately. Your dates, your price and your right to a full refund at any time before it
          ships are all exactly where they were.
        </p>
      </div>
      <div class="flex flex-col sm:flex-row gap-3 justify-center items-center mt-8">
        <a href="/books" data-cta="preorder-closed-books" class={cn(buttonVariants({ variant: "eden", size: "xl" }), "text-center")}>See the printed year · $249</a>
        <a href="/starter" data-cta="preorder-closed-starter" class={cn(buttonVariants({ variant: "eden-outline", size: "xl" }), "text-center")}>Try nine weeks · $39</a>
      </div>
      <p class="font-body text-sm text-muted-foreground mt-6">
        Questions about an existing order? Email <a href="mailto:hello@edeninstitute.health" class="underline">hello@edeninstitute.health</a> and I answer them myself.
      </p>
    </div>
  </section>
</MarketingLayout>
