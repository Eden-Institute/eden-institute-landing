---
// /back-to-eden — the book page for Back to Eden: A Biblical Foundation for Herbal Healing.
// Built 2026-09-25 (founder: the "Buy the Book" link should land on a page that makes the case
// that this book shaped everything, then pitches the course; Amazon is being cut out).
//
// Order of the page follows standard long-form book sales pages: promise + cover + two CTAs above
// the fold, the reader's problem in the author's own words, why this book (the framework behind
// every Eden product), what you will discover, what is inside, the three editions with prices,
// a free-chapter capture, the Tier 1 course, the author, everything else, FAQ, final CTA, and a
// sticky mobile buy bar. No reviews yet (founder: none to quote; add real ones after the proofs).
//
// Copy sources: the Amazon description and About the Author are Camila's own; chapter blurbs are the
// manuscript's table of contents; Tier 1 facts come from /courses; shipping time and refund terms
// from /books and /returns. Prices are the founder's 2026-09-25 "mid ladder".
//
// SELLING IS NOT LIVE YET. BUY_LIVE stays false until the book products exist in Stripe and the
// print/digital checkout lands (separate PR). Until then each edition shows "Coming soon" and the
// free Chapter 1 is the call to action. The Chapter 1 buttons open the shared waitlist modal
// (WaitlistController) with source back_to_eden_ch1; resend-waitlist sends the chapter.
import MarketingLayout from "../layouts/MarketingLayout.astro";
import WaitlistController from "../components/islands/WaitlistController.tsx";
import BookCheckoutController from "../components/islands/BookCheckoutController.tsx";
import { buttonVariants } from "@/components/ui/button";
import { cn } from "@/lib/utils";
import { BookOpen, CheckCircle, Download, Headphones, Leaf, Printer, Search, Smartphone, Sprout } from "lucide-react";

const BUY_LIVE = false;
const COURSE = "/go/course?src=back-to-eden";

const btn = (variant: "eden" | "eden-outline", extra = "") =>
  cn(buttonVariants({ variant, size: "xl" }),
     "text-center w-full sm:w-auto h-auto whitespace-normal text-sm sm:text-base leading-snug min-h-[48px] py-3 px-6", extra);

const ch1 = {
  "data-waitlist-source": "back_to_eden_ch1",
  "data-waitlist-title": "Read Chapter 1 free",
  "data-waitlist-subtitle":
    "Check your inbox. Chapter 1 of Back to Eden, The Life Force Has a Name, is on its way now, with the Reflect & Apply questions at the end.",
  "data-waitlist-cta-href": "https://edeninstitute.health/back-to-eden#editions",
  "data-waitlist-cta-label": "See the three editions",
  "data-waitlist-cta-blurb": "While you wait: the whole book comes as a paperback, a spiral Study & Journal Edition, or a Study Guide, in print or as a download.",
};

