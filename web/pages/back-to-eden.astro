// Pull quotes, all from the manuscript (chapter noted). Not reviews.
const quotes = [
  ["You have not borrowed anyone else's inheritance. You have simply forgotten your own.", 2],
  ["Symptom suppression is tape over the dashboard. It does not repair the car. It removes the only signal telling you the car needs repair.", 5],
  ["The body is not confused. It is communicating in the only language available to it.", 5],
  ["A sound mind is not merely correct theology. It is regulated physiology.", 6],
  ["Terrain is not fate. It is history expressed biologically.", 7],
  ["That is not herbalism. That is green allopathy with better branding.", 9],
];

const whoFor = [
  "You've used herbs for a while and want to understand why they work, or why they haven't.",
  "You want a framework rooted in Scripture, not borrowed from another religion's philosophy.",
  "You teach Eden's Table at home and want the adult foundation underneath it.",
  "You're thinking about the Tier 1 course and want to start with the book it's built on.",
];

// Comparison table: [label, study-journal, paperback, study-guide]. true/false or text.
const compare: [string, boolean | string, boolean | string, boolean | string][] = [
  ["The complete book text", true, true, false],
  ["Large 12 pt type", true, true, "n/a"],
  ["Study guide for every chapter", true, false, true],
  ["Notes column beside the text", true, false, false],
  ["Reflect & Apply with room to write", true, false, true],
  ["9 Tier 1 worksheets + capstone", true, false, true],
  ["9 full-color concept graphics", true, false, true],
  ["Lies flat (spiral bound)", true, false, true],
];
const money = (n: number) => (Number.isInteger(n) ? `$${n}` : `$${n.toFixed(2)}`);

const discover = [
  "Why your body's symptoms are signals, not mistakes, and why suppressing them creates chronic disease",
  "How God designed the body to heal itself, and what gets in the way",
  "The five tenets of health, and why foundation always comes before any herb",
  "What your constitution is, why it matters more than any diagnosis, and how to recognize your own",
  "How plants speak the same language as your body, through taste, energy, and tissue affinity",
  "Why the most important clinical skill isn't knowing herbs, it's learning to see the person in front of you",
];

const chapters = [
  ["The Life Force Has a Name", "On the intelligence of living systems, the failure of mechanistic medicine, and what Scripture reveals about the source of biological order."],
  ["The Forgotten Lineage", "How the Christian tradition generated, preserved, and democratized herbal medicine across two thousand years, and why you belong to that lineage."],
  ["The Great Reduction", "How modern medicine reduced the body from a living whole to a collection of parts, and what we lost in that reduction."],
  ["Fear as a Business Model", "On the weaponization of fear in healthcare, the erosion of bodily trust, and what it means to reclaim stewardship of your own health."],
  ["Symptoms Are Signals", "Why symptoms are not the enemy, what the body is actually doing when it produces them, and the cost of suppression."],
  ["The Five Tenets of Health", "The foundational principles that govern how the body sustains, defends, and restores itself, and how herbal medicine works with each of them."],
  ["Acute, Chronic & the Formation of Terrain", "The difference between a crisis response and a constitutional pattern, how chronic disease develops, and why terrain, not pathogen, is the primary field of herbal work."],
  ["Constitution", "The art of reading a person, their patterns, tendencies, and predispositions, before reaching for any remedy."],
  ["The Holistic Plant", "How to read an herb the way traditional herbalists read it, through taste, energetics, tissue affinity, and the logic of its design."],
  ["How to Begin", "Five practical movements that carry you from understanding into practice, without rushing past the foundation."],
];

const everything = [
  { icon: Search, title: "Discover Your Body Pattern", body: "The quiz that reads your constitutional pattern, the work of Chapter 8.", href: "/assessment", cta: "bte-cross-quiz" },
  { icon: Sprout, title: "Eden's Table", body: "A Christ-centered homeschool herbalism curriculum, one plant a week. Week 1 is free.", href: "/homeschool", cta: "bte-cross-homeschool" },
  { icon: Smartphone, title: "Eden Apothecary", body: "The Eden Institute herb reference app.", href: "/apothecary", cta: "bte-cross-app" },
  { icon: Headphones, title: "Tales & Table Talk", body: "A weekly read-aloud podcast for moms and their littles.", href: "/tales-and-table-talk", cta: "bte-cross-podcast" },
  { icon: Leaf, title: "Order Your Herbs", body: "Source the herbs used across the Eden's Table curriculum.", href: "/homeschool/herbs", cta: "bte-cross-herbs" },
];

const faqs = [
  ["Which edition should I choose?",
   "If you want to study, take notes and do the worksheets, choose the Study & Journal Edition: it holds the whole book and the workbook in one spiral book that lies flat. If you already have the paperback, or want a lighter book to carry, pair the paperback with the Study Guide. If you just want to read, the paperback is all you need."],
  ["Print or digital?",
   "Print editions are printed to order and mailed to you. Digital editions are PDFs you can read on any device and print at home, and they are the same pages as the print books, so the journal pages and worksheets print ready to use."],
  ["How long does a printed book take?",
   "Each copy is printed when you order it and is usually at your door in about two to three weeks."],
  ["Can I return it?",
   "Printed books are made just for you, so you have 48 hours after ordering to cancel for a full refund. If a book arrives damaged or misprinted, send a photo within 14 days and we replace it at no cost. Digital downloads can be refunded in full until you download them. The full policy is on our returns page."],
  ["Is this medical advice?",
   "No. This book is for education. It does not diagnose, treat, cure or prevent any disease, and it is not a substitute for a qualified healthcare provider, especially if you are pregnant, nursing, managing a chronic condition or taking prescription medication."],
  ["Do I have to be a Christian to read it?",
   "The book is written openly from a Christian worldview; Scripture is the lens, not decoration. Readers from other traditions are welcome, and the framework is useful whatever you believe."],
];

const meta = {
  title: "Back to Eden: A Biblical Foundation for Herbal Healing | The Eden Institute",
  description:
    "The book behind everything The Eden Institute teaches. Learn the framework that makes every herb make sense: symptoms as signals, the five tenets, constitution, and reading the whole plant. Paperback, Study & Journal Edition, or Study Guide, in print or as a download. Read Chapter 1 free.",
  canonical: "https://edeninstitute.health/back-to-eden",
};

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Book",
  name: "Back to Eden: A Biblical Foundation for Herbal Healing",
  author: { "@type": "Person", name: "Camila Johnson" },
  publisher: { "@type": "Organization", name: "The Eden Institute", url: "https://edeninstitute.health" },
  inLanguage: "en",
  url: meta.canonical,
  image: "https://edeninstitute.health/books/back-to-eden-paperback.webp",
  bookEdition: ["Paperback", "Study & Journal Edition", "Study Guide"],
};
---

<MarketingLayout title={meta.title} description={meta.description} canonical={meta.canonical}
  ogImage="https://edeninstitute.health/books/back-to-eden-paperback.webp" jsonLd={jsonLd}>

  {/* HERO */}
  <section class="px-6 pt-14 pb-16" style="background-color:hsl(var(--eden-forest))">
    <div class="mx-auto grid max-w-5xl items-center gap-10 md:grid-cols-[1.25fr_1fr]">
      <div class="text-center md:text-left">
        <p class="font-accent mb-3 text-xs uppercase tracking-[0.2em]" style="color:hsl(var(--eden-gold))">The book behind everything we teach</p>
        <h1 class="font-serif text-4xl font-bold leading-tight text-white md:text-5xl">Back to Eden</h1>
        <p class="mt-2 font-serif text-xl italic text-white/85 md:text-2xl">A Biblical Foundation for Herbal Healing</p>
        <p class="mt-6 font-body text-base leading-relaxed text-white/85 md:text-lg">
          Why aren't the herbs working? Not because the plants have failed. Not because you did anything wrong.
          <strong class="text-white">Because no one ever taught you the framework.</strong> This book gives it back.
        </p>
        <div class="mt-8 flex flex-col items-stretch gap-3 sm:flex-row sm:justify-center md:justify-start">
          <a href="#editions" data-cta="bte-hero-editions" class={btn("eden", "bg-[hsl(var(--eden-gold))] text-[hsl(var(--eden-bark))] border-[hsl(var(--eden-gold))] hover:bg-[hsl(var(--eden-gold)/0.9)]")}>Choose your edition</a>
          <button type="button" data-cta="bte-hero-ch1" {...ch1} class={btn("eden-outline", "bg-transparent text-white border-white/70 hover:bg-white/10")}>Read Chapter 1 free</button>
        </div>
        <p class="mt-4 font-body text-xs text-white/70">Paperback, spiral Study &amp; Journal Edition, or Study Guide · in print or as an instant download</p>
        <ul class="mt-6 flex flex-wrap justify-center gap-x-5 gap-y-2 font-body text-xs uppercase tracking-wider md:justify-start" style="color:hsl(var(--eden-gold))">
          <li>10 chapters</li><li>107 key terms</li><li>50 reflection prompts</li><li>9 course worksheets</li>
        </ul>
      </div>
      <div class="mx-auto w-56 md:w-72">
        <img src="/books/back-to-eden-paperback.webp" width="640" height="960" alt="Back to Eden by Camila Johnson, book cover"
          class="w-full rounded-sm shadow-2xl ring-1 ring-black/20" fetchpriority="high" />
      </div>
    </div>
  </section>

  {/* THE PROBLEM, in Camila's words */}
  <section class="bg-background px-6 py-16">
    <div class="mx-auto max-w-2xl font-body text-lg leading-relaxed" style="color:hsl(var(--eden-bark))">
      <p>You've read the books. You've bought the tinctures. You've followed the protocols. And still, you don't feel the results you expected.</p>
      <p class="mt-5">Herbal medicine was never designed to be a list of remedies. It was designed to restore, the way God's original design intended. But somewhere along the way, we started treating herbs like pharmaceuticals: one herb, one symptom, one protocol. And we lost the whole picture.</p>
      <p class="mt-5 font-serif text-2xl font-bold" style="color:hsl(var(--eden-forest))"><em>Back to Eden</em> gives you that picture back.</p>
      <p class="mt-5">This is not a remedy guide. There are no protocols here, no "best herb for anxiety" lists. This is a foundation, the kind that makes every herb you've ever studied suddenly make sense.</p>
    </div>
  </section>

  {/* WHO IT'S FOR */}
  <section class="px-6 pb-16 bg-background">
    <div class="mx-auto max-w-3xl rounded-lg border p-8" style="border-color:hsl(var(--eden-gold) / 0.4);background-color:hsl(var(--eden-parchment))">
      <h2 class="mb-5 font-serif text-2xl font-bold" style="color:hsl(var(--eden-bark))">This book is for you if</h2>
      <ul class="space-y-3">
        {whoFor.map((w) => (
          <li class="flex gap-3 font-body" style="color:hsl(var(--eden-bark))"><CheckCircle className="mt-1 h-5 w-5 flex-shrink-0" color="hsl(var(--eden-forest))" />{w}</li>
        ))}
      </ul>
      <p class="mt-6 font-body text-sm italic text-muted-foreground">If you want a list of the best herb for every ailment, this isn't that book. Those exist in abundance, and they are part of the problem.</p>
    </div>
  </section>

  {/* WHERE IT ALL STARTED */}
  <section class="px-6 py-16" style="background-color:hsl(var(--eden-cream))">
    <div class="mx-auto max-w-5xl">
      <div class="mx-auto mb-10 max-w-2xl text-center">
        <p class="font-accent mb-2 text-xs uppercase tracking-[0.2em]" style="color:hsl(var(--eden-gold-ink))">Where it all started</p>
        <h2 class="font-serif text-3xl font-bold" style="color:hsl(var(--eden-bark))">Everything at The Eden Institute grows out of this book</h2>
        <p class="mt-4 font-body text-muted-foreground">
          The five tenets our homeschool families learn at the kitchen table, the body patterns behind our quiz and our herb app,
          and the Tier 1 course, which teaches this book lesson by lesson. It all starts here.
        </p>
      </div>
      <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
        <a href={COURSE} data-cta="bte-origin-course" class="rounded-lg border bg-white p-6 transition-shadow hover:shadow-md" style="border-color:hsl(var(--eden-gold) / 0.4)">
          <BookOpen className="mb-3 h-7 w-7" color="hsl(var(--eden-gold))" />
          <h3 class="font-serif text-lg font-bold" style="color:hsl(var(--eden-forest))">The Tier 1 course</h3>
          <p class="mt-2 font-body text-sm text-muted-foreground">Ten lessons that walk through this book with Camila.</p>
        </a>
        <a href="/homeschool" data-cta="bte-origin-homeschool" class="rounded-lg border bg-white p-6 transition-shadow hover:shadow-md" style="border-color:hsl(var(--eden-gold) / 0.4)">
          <Sprout className="mb-3 h-7 w-7" color="hsl(var(--eden-gold))" />
          <h3 class="font-serif text-lg font-bold" style="color:hsl(var(--eden-forest))">Eden's Table</h3>
          <p class="mt-2 font-body text-sm text-muted-foreground">The same framework, taught to children one plant a week.</p>
        </a>
        <a href="/assessment" data-cta="bte-origin-quiz" class="rounded-lg border bg-white p-6 transition-shadow hover:shadow-md" style="border-color:hsl(var(--eden-gold) / 0.4)">
          <Search className="mb-3 h-7 w-7" color="hsl(var(--eden-gold))" />
          <h3 class="font-serif text-lg font-bold" style="color:hsl(var(--eden-forest))">The Body Pattern quiz</h3>
          <p class="mt-2 font-body text-sm text-muted-foreground">Chapter 8's constitution work, as a quiz you can take today.</p>
        </a>
        <a href="/apothecary" data-cta="bte-origin-app" class="rounded-lg border bg-white p-6 transition-shadow hover:shadow-md" style="border-color:hsl(var(--eden-gold) / 0.4)">
          <Smartphone className="mb-3 h-7 w-7" color="hsl(var(--eden-gold))" />
          <h3 class="font-serif text-lg font-bold" style="color:hsl(var(--eden-forest))">Eden Apothecary</h3>
          <p class="mt-2 font-body text-sm text-muted-foreground">Chapter 9's way of reading a plant, in an herb reference app.</p>
        </a>
      </div>
    </div>
  </section>

  {/* WHAT YOU WILL DISCOVER */}
  <section class="bg-background px-6 py-16">
    <div class="mx-auto max-w-3xl">
      <h2 class="mb-8 text-center font-serif text-3xl font-bold" style="color:hsl(var(--eden-bark))">What you'll discover</h2>
      <ul class="space-y-4">
        {discover.map((d) => (
          <li class="flex gap-3 font-body text-base leading-relaxed" style="color:hsl(var(--eden-bark))">
            <CheckCircle className="mt-1 h-5 w-5 flex-shrink-0" color="hsl(var(--eden-forest))" />{d}
          </li>
        ))}
      </ul>
      <blockquote class="scripture-block mx-auto mt-10 max-w-xl text-center text-base text-muted-foreground">
        "And God said, 'See, I have given you every herb that yields seed which is on the face of all the earth.'"
        <footer class="mt-2 font-body text-xs font-medium uppercase tracking-wider not-italic" style="color:hsl(var(--eden-forest))">Genesis 1:29</footer>
      </blockquote>
    </div>
  </section>

  {/* LOOK INSIDE */}
  <section class="bg-background px-6 py-16">
    <div class="mx-auto max-w-6xl">
      <div class="mx-auto mb-10 max-w-2xl text-center">
        <h2 class="font-serif text-3xl font-bold" style="color:hsl(var(--eden-bark))">Look inside</h2>
        <p class="mt-3 font-body text-muted-foreground">Real pages from the Study &amp; Journal Edition. The Study Guide has every one of them except the book text.</p>
      </div>
      <div class="-mx-6 flex snap-x snap-mandatory gap-5 overflow-x-auto px-6 pb-4 md:mx-0 md:grid md:grid-cols-3 md:overflow-visible md:px-0 lg:grid-cols-6">
