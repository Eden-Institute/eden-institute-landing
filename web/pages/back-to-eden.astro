    ],
    details: [
      ["The complete book", "All ten chapters of Back to Eden in three parts: The Foundation, The Body Was Designed to Heal, and Reading the Person."],
      ["Made to be read", "Set in 12 pt type on a comfortable 6 × 9 page, so it reads easily at the kitchen table or in the car line."],
      ["Questions at the end of every chapter", "Each chapter closes with its Reflect & Apply questions. If you want room to answer them, the Study Guide is built to sit right beside this book."],
    ],
    print: 24.99, ship: 6, digital: 14.99,
  },
  {
    id: "study-guide",
    name: "Study Guide",
    badge: "Pairs with the paperback",
    img: "/books/back-to-eden-study-guide.webp",
    size: "8.5 × 11 in · spiral bound · full color · 266 pages",
    blurb: "Everything in the Study & Journal Edition except the book text. Keep it open beside the paperback.",
    bestFor: "Readers who already have the book, and study partners reading together.",
    value: "Includes the same worksheets students use in the $97 Tier 1 course.",
    includes: [
      "10 chapter study guides with 107 key terms",
      "50 Reflect & Apply prompts with room to write",
      "9 Tier 1 course worksheets plus the capstone project",
      "9 full-color concept graphics",
      "Wrap-up and notes pages for every chapter",
    ],
    details: [
      ["A study guide for every chapter", "The Scripture anchor, the key idea, what you will be able to do, and 107 key terms across the book."],
      ["Reflect & Apply journal pages", "All fifty prompts, each with room for a real answer."],
      ["The Tier 1 course worksheets", "The same nine worksheets and the 13-page capstone project as the Study & Journal Edition."],
      ["Nine full-color concept graphics", "The big ideas of each chapter, one page each."],
