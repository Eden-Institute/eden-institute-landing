const lookInside = [
  ["/books/bte-look-chapter-page.webp", "A photo page opens every chapter"],
  ["/books/bte-look-study-guide.webp", "A study guide before every chapter"],
  ["/books/bte-look-notes-column.webp", "A notes column beside the text"],
  ["/books/bte-look-journal.webp", "Reflect & Apply, with room to write"],
  ["/books/bte-look-worksheet.webp", "The Tier 1 course worksheets"],
  ["/books/bte-look-paperback.webp", "The paperback, in large 12 pt type"],
];

// The nine concept graphics (Study & Journal Edition and Study Guide), picked from a page-by-page scan of
// the 380-page book on 2026-09-25 as the pages that make the case fastest: each is one chapter's argument on one page.
const ideas = [
  ["lineage", "The Forgotten Lineage", 2, "From Scripture to the monasteries to the Eclectics, and to you."],
  ["two-models", "Two Models of Health", 3, "The deficiency model and the terrain model, side by side."],
  ["symptoms", "Symptoms Are Signals", 5, "What you see is not what is wrong."],
  ["five-tenets", "The Five Tenets of Health", 6, "Hydration, Movement, Nutrition, Rest, Connection."],
  ["terrain", "Acute, Chronic & Terrain", 7, "How an acute illness becomes a chronic one, stage by stage."],
  ["constitution", "Constitutional Polarities", 8, "Hot or cold, damp or dry, tense or relaxed."],
  ["holistic-plant", "The Holistic Plant", 9, "Five lenses for reading God's provision."],
  ["taste", "Taste as Pharmacology", 9, "The six tastes and what each one does."],
  ["how-to-begin", "How to Begin", 10, "Five movements from understanding into practice."],
