---
// /starter/seedlings/thank-you — Seedlings Starter Unit order confirmation.
//
// Reached from Stripe's success_url with ?session_id={CHECKOUT_SESSION_ID}
// (STARTER_BANDS.seedlings.successUrl in supabase/functions/_shared/starter-config.ts).
// Mirrors /starter/thank-you with the band swapped. A separate page rather than a
// flag on the Sprouts one, so that neither the conversion event nor the upgrade
// copy can ever name the wrong band.
//
// The Seedlings printed year is not on sale yet (2026-09-23), so the upgrade
// section says so plainly and links nowhere it cannot deliver.
//
// noindex: a confirmation page has nothing to offer search, and the session id in
// the URL should not end up in an index.
//
// Copy rule: no em dashes (feedback_no_em_dashes).
import MarketingLayout from "../../../layouts/MarketingLayout.astro";
import StarterDownloads from "../../../components/islands/StarterDownloads.tsx";

const meta = {
  title: "Your Starter Unit is ready · Eden's Table | The Eden Institute",
  description: "Download your Eden's Table Seedlings Starter Unit.",
  canonical: "https://edeninstitute.health/starter/seedlings/thank-you",
};
---

<MarketingLayout
  title={meta.title}
  description={meta.description}
  canonical={meta.canonical}
  noindex={true}
>
  <section class="pt-20 pb-10 px-6" style="background-color:hsl(var(--eden-cream))">
    <div class="max-w-2xl mx-auto text-center">
      <p class="font-accent text-sm tracking-[0.3em] uppercase mb-4" style="color:hsl(var(--eden-gold-ink))">
        Thank you
      </p>
      <h1 class="font-serif text-4xl md:text-5xl font-bold leading-tight mb-6" style="color:hsl(var(--eden-bark))">
        Your first nine weeks are ready.
      </h1>
      <div class="w-16 h-px mx-auto my-6" style="background-color:hsl(var(--eden-gold))"></div>
      <p class="font-body text-lg text-muted-foreground leading-relaxed">
        They are downloading below, and a copy is on its way to your inbox.
      </p>
    </div>
  </section>

  <section class="py-12 px-6 bg-background">
    <div class="max-w-xl mx-auto">
      <StarterDownloads client:only="react" mode="session" showCredit={false} />
    </div>
  </section>

  <section class="py-16 px-6" style="background-color:hsl(var(--eden-cream))">
    <div class="max-w-2xl mx-auto text-center">
      <h2 class="font-serif text-3xl font-bold mb-6" style="color:hsl(var(--eden-bark))">
        When you are ready for the whole year.
      </h2>
      <p class="font-body text-base text-muted-foreground leading-relaxed">
        The printed Seedlings year, with the Teacher's Guide, the Student Notebook and the whole
        Read-Aloud storybook for all 36 weeks, is being finished now. No hurry, and no penalty
        for taking your time with the nine weeks you just bought.
      </p>
    </div>
  </section>
</MarketingLayout>

<script>
  // Purchase conversion for the Seedlings Starter Unit. Same event name as the
  // Sprouts page (starter_unit_purchase) so the two sum as Starter revenue, with
  // its own label and item id so they can be told apart. Same guards: the session
  // id never reaches GA (transaction_id is its hashed reference), and a refresh
  // does not report a second sale. See /starter/thank-you for the full reasoning.
  import { readCheckoutSessionId } from "@/lib/checkoutSession";
  import { checkoutRef } from "@/lib/pinterestTag";

  (async () => {
    try {
      const sessionId = readCheckoutSessionId();
      const ref = sessionId ? await checkoutRef(sessionId) : null;
      const key = `starter_conv_${ref ?? "noref"}`;
      if (sessionId && !sessionStorage.getItem(key)) {
        sessionStorage.setItem(key, "1");
        (window as any).gtag?.("event", "starter_unit_purchase", {
          event_category: "conversion",
          event_label: "seedlings_starter_unit",
          value: 39.0,
          currency: "USD",
          ...(ref ? { transaction_id: ref } : {}),
          items: [{ item_id: "seedlings_starter_unit", item_name: "Seedlings Starter Unit", price: 39.0, quantity: 1 }],
        });
      }
    } catch {
      // Analytics never break the page.
    }
  })();
</script>
