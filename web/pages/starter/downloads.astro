---
// /starter/downloads — where a Starter Unit buyer gets their files.
//
// As of 2026-09-05 this is the PRIMARY destination, not just the re-request
// path. The delivery email now sends buyers here rather than at three raw PDF
// URLs, because a page can explain itself and a PDF cannot: a buyer tapped a
// direct link from inside her mail app, got a white screen from an embedded
// browser with no PDF viewer, and had no way to tell that from a broken product.
//
// Signed URLs still last seven days; the ?t= token in the email does not expire,
// so the same email keeps working months later, on any device.
//
// The page holds no credentials of its own: without a valid token the island
// renders a refusal, so the page is harmless if it is ever found. noindex keeps
// it out of search regardless, matching /partner-sample.
//
// NO THIRD-PARTY TAGS HERE (noThirdPartyTags below). The ?t= token stays in the
// address bar, so the emailed link, a copied link, a bookmark and "Open in
// Safari" keep working on any device, as the copy below promises. That is only
// safe because nothing on this page can read the URL and send it on: no Google
// Analytics, no Google Tag Manager, no Pinterest tag, no Meta Pixel, and a
// no-referrer policy for everything the page fetches or opens. Case variants
// such as /Starter/Downloads would reach the SPA, which does load Google
// Analytics, so vercel.json redirects them here first.
//
// Copy rule: no em dashes (feedback_no_em_dashes).
import MarketingLayout from "../../layouts/MarketingLayout.astro";
import StarterDownloads from "../../components/islands/StarterDownloads.tsx";

const meta = {
  title: "Your Starter Unit downloads · Eden's Table | The Eden Institute",
  description: "Fresh download links for your Eden's Table Sprouts Starter Unit.",
  canonical: "https://edeninstitute.health/starter/downloads",
};
---

<MarketingLayout
  title={meta.title}
  description={meta.description}
  canonical={meta.canonical}
  noindex={true}
  noThirdPartyTags={true}
>
  <section class="pt-20 pb-10 px-6" style="background-color:hsl(var(--eden-cream))">
    <div class="max-w-2xl mx-auto text-center">
      <p class="font-accent text-sm tracking-[0.3em] uppercase mb-4" style="color:hsl(var(--eden-gold-ink))">
        Eden's Table · Sprouts
      </p>
      <h1 class="font-serif text-4xl md:text-5xl font-bold leading-tight mb-6" style="color:hsl(var(--eden-bark))">
        Your Starter Unit
      </h1>
      <div class="w-16 h-px mx-auto my-6" style="background-color:hsl(var(--eden-gold))"></div>
      <p class="font-body text-lg text-muted-foreground leading-relaxed">
        Your Teacher's Guide, Student Notebook and Read-Aloud Storybook. Come back to this
        page any time, on any device.
      </p>
    </div>
  </section>

  <section class="py-12 px-6 bg-background">
    <div class="max-w-xl mx-auto">
      <StarterDownloads client:only="react" mode="token" />
      {/* client:only means this island renders nothing at all server-side, so a
          reader whose JavaScript never runs would otherwise meet an empty box on
          the page they were sent to for their paid files. This is the floor. */}
      <noscript>
        <div
          class="rounded-lg p-6 text-center"
          style="background-color:hsl(var(--eden-cream));border:1px solid hsl(var(--eden-gold))"
        >
          <p class="font-body text-base" style="color:hsl(var(--eden-bark))">
            This page needs JavaScript to fetch your files securely. If you are reading this,
            it is switched off or blocked. Open this link in Safari or Chrome, or email
            <a href="mailto:hello@edeninstitute.health" class="underline" style="color:hsl(var(--eden-forest))">
              hello@edeninstitute.health
            </a>
            and we will send your three files straight to you by hand.
          </p>
        </div>
      </noscript>
      <p class="font-body text-sm text-muted-foreground text-center mt-8">
        Something not working? Email
        <a href="mailto:hello@edeninstitute.health" class="underline" style="color:hsl(var(--eden-forest))">
          hello@edeninstitute.health
        </a>
        and we will send your files by hand.
      </p>
    </div>
  </section>
</MarketingLayout>
