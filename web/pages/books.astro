---
// /books: the printed Sprouts curriculum, sold as one set and printed to order
// by Lulu.
//
// THE PRICE IS NOT IN THIS FILE. The buy box reads it from the
// print_products_public view. The $249 in the copy below is display copy; if
// the price ever changes, change it there first and then here.
//
// 2026-09-12, the print-first pivot: this page became the lead product. Until
// today it was positioned against the $249 founding kit ("same price, the
// difference is when"), because both were on sale. The kit came off the site,
// so every comparison to it is gone and the page now argues for itself. The
// old positioning copy and the kit FAQs are on b8751c1 for phase two.
//
// 2026-09-23: the Seedlings (grades 3-5) printed set sits on this page too, in
// its own section (#seedlings) with its own buy box (PrintBuyBox band=
// "seedlings"). Until its Stripe Price, shipping tier and Lulu files are all in,
// that box says "coming soon". The Seedlings copy states only what is verified:
// grades 3-5, 36 weeks, the three books, their formats, $249 (founder decision
// 2026-09-23). Page counts added 2026-09-25 (founder decision): 245 / 227 / 160,
// measured from the final Lulu interior PDFs and equal to SEEDLINGS_PAGE_COUNTS in
// supabase/functions/_shared/lulu-config.ts. Change both together.
// 2026-09-24: Seedlings went on sale. The meta tags, the hero and the Product
// JSON-LD now cover both bands, and a BandChooser sits under the hero.
// 2026-09-26 (founder): extra notebooks $32 each from the 6th, up to 100 an
// order; and a both-years section (#both, PrintBuyBox band="both"), $429 + $12
// vs $498 separately. The $429 / $498 here are display copy like the $249: the
// price the buyer pays comes from the products row and Stripe. That box says
// "coming soon" until the bundle's Stripe Price exists and its row is active.
// Shipping (founder 2026-09-26, "whatever covers my cost"): calculated per cart
// by printShippingCents (supabase/functions/_shared/print-pricing.ts) and shown in
// the buy box before checkout. One set is $12 and the bundle $16; "flat" is gone
// from the copy because larger orders cost more.
//
// Copy rule: no em dashes.
import MarketingLayout from "../layouts/MarketingLayout.astro";
import PrintBuyBox from "../components/islands/PrintBuyBox.tsx";
import ComponentShowcases from "../components/ComponentShowcases.astro";
import BandChooser from "../components/BandChooser.astro";
// Hero watermark: calendula, public domain (Koehler's Medizinal-Pflanzen), built
// with scripts/build_hero.py and contrast-audited (worst 4.73:1, floor 4.5).
// Same treatment as /starter and /preorder.
import heroBooks from "@/assets/hero-books.jpg";
import HeroBackdrop from "../components/HeroBackdrop.astro";
import { printOfferPolicies } from "../lib/merchantOffer";

const meta = {
  title: "Printed Homeschool Herbalism Curriculum, Sprouts K-2 and Seedlings 3-5 · Eden's Table",
  description:
    "The Eden's Table Teacher's Guide, Student Notebook and Read-Aloud storybook for Sprouts (K-2) or Seedlings (3-5), printed to order and at your door in about two to three weeks. All 36 weeks, $249 plus $12 shipping.",
  canonical: "https://edeninstitute.health/books",
};

const books = [
  {
    title: "The Teacher's Guide",
    pages: "240 pages, letter size, coil bound",
    body: "Every day of all 36 weeks, written out. What to read, what to say, what to put on the table, and which subjects that week's plant is carrying. It lies flat while you teach, because you will have a child on your lap and a mug in your other hand.",
  },
  {
    title: "The Student Notebook",
    pages: "224 pages, letter size, coil bound",
    body: "Her pages. She draws the plant she just held, writes what it smelled like, copies the verse, and answers a question in her own handwriting every week. By May it is a full year of her work, dated and in order, which is also your record keeping done.",
  },
  {
    title: "The Read-Aloud Storybook",
    pages: "112 pages, small paperback",
    body: "The seven stories that run through the year, sized for a lap. This is the one you read on the couch, with a child under each arm.",
  },
];

const faqs = [
  {
    q: "Is this the whole curriculum, or a sample of it?",
    a: "The whole thing. All 36 weeks, 180 daily lessons, every plant, every story, every lab. Nothing in the year is held back for a later purchase.",
  },
  {
    q: "Can I buy just one of the three?",
    a: "No. They are written to be used together, one plant a week, and one without the others would leave you stuck by Wednesday. The one exception is the Student Notebook: it is the write-in book, so you can add extra copies for siblings at checkout, $39.99 each for the first five and $32 each from the sixth (up to 100 in one order, for co-ops), printed and shipped with your set. Shipping for larger orders is calculated in your cart before you pay.",
  },
  {
    q: "How is it printed, and how long does it take?",
    a: "Each set is printed for you when you order, by our print partner, and mailed straight to your address. Printing starts 48 hours after you order. That pause is on purpose: it is your window to fix a typo in your address or change your mind for a full refund. After that it prints, and you get a tracking email the day it ships. Plan on about two to three weeks from order to your door.",
  },
  {
    q: "Can I return it?",
    a: "Once printing has started, no, because it was printed for you and nobody else. Before that, yes, for a full refund, just reply to your confirmation email. If a book arrives bent, misprinted or damaged, send me a photo within 14 days and I will replace it at no cost to you.",
  },
  {
    q: "Is this a good place to start, or should I try the $39 Starter Unit first?",
    a: "If you are still deciding whether this is how your family wants to learn, start with the nine-week Starter Unit. It is a download and it is $39, so finding out costs you very little. If you have already decided and you want the whole year on paper, this is the page.",
  },
];

const productJsonLd = {
  "@context": "https://schema.org",
  "@type": "Product",
  name: "Eden's Table: Sprouts Printed Curriculum Set",
  sku: "sprouts_print_set",
  description:
    "The Eden's Table Sprouts (K-2) Teacher's Guide (240 pages), Student Notebook (224 pages) and Read-Aloud Storybook (112 pages), printed to order and shipped within the United States. 36 weeks, 180 daily lessons, one plant a week.",
  image: "https://edeninstitute.health/showcases/ET_PrintSet.webp",
  brand: { "@type": "Brand", name: "Eden's Table" },
  offers: {
    "@type": "Offer",
    price: "249.00",
    priceCurrency: "USD",
    availability: "https://schema.org/InStock",
    url: meta.canonical,
    seller: { "@type": "Organization", name: "Rooted in Faith Ventures LLC" },
    ...printOfferPolicies("sprouts_print_set"),
  },
};

const seedlingsProductJsonLd = {
  "@context": "https://schema.org",
  "@type": "Product",
  name: "Eden's Table: Seedlings Printed Curriculum Set",
  sku: "seedlings_print_set",
  description:
    "The Eden's Table Seedlings (grades 3-5) Teacher's Guide (245 pages), Student Notebook (227 pages) and Read-Aloud Storybook (160 pages), printed to order and shipped within the United States. 36 weeks, one plant a week, a different 36 plants from Sprouts.",
  image: "https://edeninstitute.health/showcases/ET_Seedlings_PrintSet_Pages.webp",
  brand: { "@type": "Brand", name: "Eden's Table" },
  offers: {
    "@type": "Offer",
    price: "249.00",
    priceCurrency: "USD",
    availability: "https://schema.org/InStock",
    url: meta.canonical + "#seedlings",
    seller: { "@type": "Organization", name: "Rooted in Faith Ventures LLC" },
    ...printOfferPolicies("seedlings_print_set"),
  },
};

// 2026-09-30: the both-years set, so Google (and the Merchant Center feed, which
// lists the same three sets) can match it to this page. Display price like the others.
const bothProductJsonLd = {
  "@context": "https://schema.org",
  "@type": "Product",
  name: "Eden's Table: Sprouts and Seedlings Printed Curriculum Sets",
  sku: "both_bands_print_set",
  description:
    "The Sprouts set and the Seedlings set in one order: both Teacher's Guides, both Student Notebooks and both Read-Aloud storybooks. All six books, 36 weeks each, 72 different plants between the two years. Printed to order and shipped within the United States.",
  image: [
    "https://edeninstitute.health/showcases/ET_BothBands_Set_Product.webp",
    "https://edeninstitute.health/showcases/ET_PrintSet.webp",
    "https://edeninstitute.health/showcases/ET_Seedlings_PrintSet_Pages.webp",
  ],
  brand: { "@type": "Brand", name: "Eden's Table" },
  offers: {
    "@type": "Offer",
    price: "429.00",
    priceCurrency: "USD",
    availability: "https://schema.org/InStock",
    url: meta.canonical + "#both",
    seller: { "@type": "Organization", name: "Rooted in Faith Ventures LLC" },
    ...printOfferPolicies("both_bands_print_set"),
  },
};

const faqJsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map((f) => ({
    "@type": "Question",
    name: f.q,
    acceptedAnswer: { "@type": "Answer", text: f.a },
  })),
};
---

<MarketingLayout
  title={meta.title}
  description={meta.description}
  canonical={meta.canonical}
  jsonLd={[productJsonLd, seedlingsProductJsonLd, bothProductJsonLd, faqJsonLd]}
  ogType="product"
  product={{
    priceAmount: productJsonLd.offers.price,
    priceCurrency: productJsonLd.offers.priceCurrency,
    availability: "instock",
    brand: productJsonLd.brand.name,
  }}
>
  <section class="relative overflow-hidden pt-16 md:pt-20 pb-10 md:pb-12 px-6" style="background-color:hsl(var(--eden-cream))">
    <HeroBackdrop src={heroBooks} opacity={0.95} />
    <div class="relative z-10 max-w-3xl mx-auto text-center rounded-lg" style="background-color:hsl(0 0% 100% / 0.92);border:1px solid hsl(var(--eden-gold) / 0.35);padding:clamp(26px, 3.5vw, 52px);box-shadow:0 2px 18px -10px rgba(30,62,46,0.28)">
      <p class="font-accent text-sm tracking-[0.3em] uppercase mb-3 md:mb-4" style="color:hsl(var(--eden-gold-ink))">
        Eden's Table · Sprouts K-2 and Seedlings 3-5
      </p>
      <h1 class="font-serif text-4xl md:text-5xl font-bold leading-tight mb-4 md:mb-6" style="color:hsl(var(--eden-bark))">
        The whole year, printed, in your hands in about two to three weeks.
      </h1>
      <div class="w-16 h-px mx-auto my-4 md:my-6" style="background-color:hsl(var(--eden-gold-ink))"></div>
      <p class="font-body text-base md:text-xl leading-relaxed" style="color:hsl(var(--eden-bark))">
        The Teacher's Guide, the Student Notebook and the Read-Aloud storybook for all 36 weeks,
        printed to order and mailed to your door. $249 plus $12 shipping, for either year.
      </p>
      <div class="grid gap-3 sm:grid-cols-2 mt-6 max-w-xl mx-auto">
        <a href="#buy" data-cta="books-hero-sprouts" class="rounded-md border-2 px-4 py-3 font-body font-bold text-base leading-snug min-h-[48px] flex flex-col items-center justify-center" style="border-color:hsl(var(--eden-forest));background-color:hsl(var(--eden-forest));color:hsl(var(--eden-cream))">
          <span>Sprouts, grades K-2</span><span class="text-sm font-normal opacity-90">Order · $249</span>
        </a>
        <a href="#seedlings" data-cta="books-hero-seedlings" class="rounded-md border-2 px-4 py-3 font-body font-bold text-base leading-snug min-h-[48px] flex flex-col items-center justify-center" style="border-color:hsl(var(--eden-forest));background-color:hsl(var(--eden-forest));color:hsl(var(--eden-cream))">
          <span>Seedlings, grades 3-5</span><span class="text-sm font-normal opacity-90">Order · $249</span>
        </a>
      </div>
      <p class="font-body text-sm mt-4">
        <a href="#choose-band" data-cta="books-hero-which" class="underline underline-offset-4" style="color:hsl(var(--eden-forest))">Not sure which one? Most families start with Sprouts. Here is why.</a>
      </p>
    </div>
  </section>

  {/* WHY PRINTED TO ORDER. Replaced the kit-versus-books positioning block on
      2026-09-12; the old copy is on b8751c1. The point a reader must take from
      the page is now simply that nothing is on back order. */}
  <section class="py-12 px-6 bg-background">
    <div class="max-w-2xl mx-auto">
      <p class="font-accent text-xs tracking-[0.25em] uppercase mb-4 text-center" style="color:hsl(var(--eden-gold-ink))">
        Printed for you, not stacked in a warehouse.
      </p>
      <div class="font-body text-base md:text-lg leading-relaxed space-y-4" style="color:hsl(var(--eden-bark))">
        <p>
          Your set is printed after you order it, one set at a time, and mailed straight to your
          address. There is no warehouse, no minimum order I had to hit first, and nothing to be
          back-ordered on.
        </p>
        <p>
          That is deliberate. I am building this without borrowing, so I would rather print your
          copy when you ask for it than gamble on a room full of boxes. It costs a little time at
          your end, about two to three weeks, and it means your year is never waiting on my cash
          flow.
        </p>
        <p>
          Not sure yet? Week 1 is <a href="/freebies" class="underline" style="color:hsl(var(--eden-forest))">free</a> for both years,
          and the first nine weeks are $39 as a download:
          <a href="/starter" class="underline" style="color:hsl(var(--eden-forest))">Sprouts</a> or
          <a href="/starter/seedlings" class="underline" style="color:hsl(var(--eden-forest))">Seedlings</a>.
        </p>
      </div>
    </div>
  </section>

  <section class="py-12 px-6" style="background-color:hsl(var(--eden-cream))">
    <div class="max-w-5xl mx-auto grid gap-8 md:grid-cols-[1fr_380px] items-start">
      <div class="grid gap-4">
        <h2 class="font-serif text-2xl font-bold" style="color:hsl(var(--eden-forest))">What is in the set</h2>
        <div class="rounded-lg overflow-hidden bg-white shadow-sm border" style="border-color:hsl(var(--eden-gold) / 0.3)">
          <img src="/showcases/ET_PrintSet.webp" alt="The three printed Sprouts books on a linen cloth: the coil-bound Teacher's Guide and Student Notebook, and the Read-Aloud Storybook" loading="eager" width="1024" height="1024" class="w-full h-auto" />
        </div>
        <ul class="font-body text-base space-y-2 mb-2" style="color:hsl(var(--eden-bark))">
          <li class="flex gap-3"><span style="color:hsl(var(--eden-gold-ink))">·</span><span><strong>Teacher's Guide,</strong> 240 pages, letter size, coil bound. All 36 weeks.</span></li>
          <li class="flex gap-3"><span style="color:hsl(var(--eden-gold-ink))">·</span><span><strong>Student Notebook,</strong> 224 pages, letter size, coil bound. All 36 weeks.</span></li>
          <li class="flex gap-3"><span style="color:hsl(var(--eden-gold-ink))">·</span><span><strong>Read-Aloud Storybook,</strong> 112 pages, small paperback. All seven stories.</span></li>
          <li class="flex gap-3"><span style="color:hsl(var(--eden-gold-ink))">·</span><span><strong>Extra Student Notebooks for siblings,</strong> $39.99 each, $32 each from the sixth, added at checkout and shipped in the same parcel (shipping calculated in your cart).</span></li>
          <li class="flex gap-3"><span style="color:hsl(var(--eden-gold-ink))">·</span><span><strong>Printed to order, mailed to you,</strong> tracked, within the United States.</span></li>
        </ul>
        {books.map((b) => (
          <div class="rounded-lg p-5 bg-white border" style="border-color:hsl(var(--eden-gold) / 0.3)">
            <h3 class="font-serif text-lg font-bold mb-1" style="color:hsl(var(--eden-forest))">{b.title}</h3>
            <p class="font-accent text-xs tracking-[0.2em] uppercase mb-3" style="color:hsl(var(--eden-gold-ink))">{b.pages}</p>
            <p class="font-body text-sm text-muted-foreground leading-relaxed">{b.body}</p>
          </div>
        ))}
        <p class="font-body text-sm text-muted-foreground leading-relaxed">
          The herbs are not included. Each week uses a small amount of a common
          dried herb from your pantry, your garden, or the <a href="/homeschool/herbs" class="underline" style="color:hsl(var(--eden-forest))">herb list we keep for you</a>.
        </p>
      </div>
      <div id="buy" class="md:sticky md:top-24 min-[1024px]:top-36 scroll-mt-24 min-[1024px]:scroll-mt-36">
        <PrintBuyBox client:only="react" cta="books-buy" />
        <p class="font-body text-sm text-muted-foreground text-center mt-3">
          Using an education savings account or scholarship? <a href="/esa" data-cta="books-esa" class="underline" style="color:hsl(var(--eden-forest))">See how to buy in your state</a>.
        </p>
        <p class="font-body text-sm text-muted-foreground text-center mt-2">
          Ordering for a co-op or school? <a href="/groups" data-cta="books-groups" class="underline" style="color:hsl(var(--eden-forest))">See group pricing</a>.
        </p>
      </div>
    </div>
  </section>

  {/* The three books in full, same copy and photos as the hub. */}
  <ComponentShowcases only={["story", "tg", "nb"]} note="All 36 weeks of this, printed and coil bound, in the set." cta={{ href: "#buy", label: "Order the printed set · $249", dataCta: "books-showcase-buy" }} />

  <BandChooser ctaPrefix="books" onBooksPage={true} heading="Which set is right for your family?" />

  {/* SEEDLINGS, grades 3-5 (2026-09-23). Same three books, older children. */}
  <section id="seedlings" class="py-12 px-6 bg-background scroll-mt-24 min-[1024px]:scroll-mt-36">
    <div class="max-w-5xl mx-auto grid gap-8 md:grid-cols-[1fr_380px] items-start">
      <div class="grid gap-4">
        <p class="font-accent text-xs tracking-[0.25em] uppercase" style="color:hsl(var(--eden-gold-ink))">
          Eden's Table · Seedlings, grades 3-5
        </p>
        <h2 class="font-serif text-2xl font-bold" style="color:hsl(var(--eden-forest))">The Seedlings year, printed</h2>
        <p class="font-body text-base leading-relaxed" style="color:hsl(var(--eden-bark))">
          The same three books for your older children: the Teacher's Guide, the Student Notebook and the
          Read-Aloud storybook for all 36 weeks of Seedlings, printed to order and mailed to your door. $249 plus $12 shipping.
        </p>
        <p class="font-body text-base leading-relaxed" style="color:hsl(var(--eden-bark))">
          Body systems, herb profiles, a hypothesis your child writes when each jar is sealed and checks when it opens, and dinner-table questions with
          real reasoning in them. A different 36 plants from Sprouts, so a family who does both finishes with 72.
        </p>
        <ul class="font-body text-base space-y-2 mb-2" style="color:hsl(var(--eden-bark))">
          <li class="flex gap-3"><span style="color:hsl(var(--eden-gold-ink))">·</span><span><strong>Teacher's Guide,</strong> 245 pages, letter size, coil bound. All 36 weeks.</span></li>
          <li class="flex gap-3"><span style="color:hsl(var(--eden-gold-ink))">·</span><span><strong>Student Notebook,</strong> 227 pages, letter size, coil bound. All 36 weeks.</span></li>
          <li class="flex gap-3"><span style="color:hsl(var(--eden-gold-ink))">·</span><span><strong>Read-Aloud Storybook,</strong> 160 pages, small paperback.</span></li>
          <li class="flex gap-3"><span style="color:hsl(var(--eden-gold-ink))">·</span><span><strong>Extra Seedlings Student Notebooks for siblings,</strong> $39.99 each, $32 each from the sixth, added at checkout and shipped in the same parcel (shipping calculated in your cart).</span></li>
          <li class="flex gap-3"><span style="color:hsl(var(--eden-gold-ink))">·</span><span><strong>Printed to order, mailed to you,</strong> tracked, within the United States.</span></li>
        </ul>
        <p class="font-body text-sm text-muted-foreground leading-relaxed">
          Ordering both years? <a href="#both" class="underline" style="color:hsl(var(--eden-forest))" data-cta="books-seedlings-to-both">Get both sets in one order</a>, one parcel, for less.
        </p>
        <p class="font-body text-sm leading-relaxed" style="color:hsl(var(--eden-bark))">
          New to herbs? Even with a child in grades 3-5, most families start with <a href="#buy" class="underline" style="color:hsl(var(--eden-forest))" data-cta="books-seedlings-start-sprouts">Sprouts</a>, because its 36 plants are the ones Seedlings builds on. <a href="/starter#older-kids" class="underline" style="color:hsl(var(--eden-forest))">Here is why</a>.
        </p>
      </div>
      <div id="buy-seedlings" class="md:sticky md:top-24 min-[1024px]:top-36">
        <PrintBuyBox client:only="react" cta="books-buy-seedlings" band="seedlings" />
      </div>
    </div>
  </section>

  {/* BOTH YEARS (2026-09-26). Sprouts + Seedlings sets in one order. */}
  <section id="both" class="py-12 px-6 scroll-mt-24 min-[1024px]:scroll-mt-36" style="background-color:hsl(var(--eden-cream))">
    <div class="max-w-5xl mx-auto grid gap-8 md:grid-cols-[1fr_380px] items-start">
      <div class="grid gap-4">
        <p class="font-accent text-xs tracking-[0.25em] uppercase" style="color:hsl(var(--eden-gold-ink))">
          Eden's Table · Sprouts and Seedlings together
        </p>
        <h2 class="font-serif text-2xl font-bold" style="color:hsl(var(--eden-forest))">Both years, printed, in one parcel</h2>
        <p class="font-body text-base leading-relaxed" style="color:hsl(var(--eden-bark))">
          Little ones and older ones at the same table? Get the Sprouts set and the Seedlings set in one order:
          both Teacher's Guides, both Student Notebooks and both Read-Aloud storybooks. $429 plus $16 shipping,
          instead of $498 for the two sets bought separately.
        </p>
        <ul class="font-body text-base space-y-2 mb-2" style="color:hsl(var(--eden-bark))">
          <li class="flex gap-3"><span style="color:hsl(var(--eden-gold-ink))">·</span><span><strong>All six books,</strong> 36 weeks each, 72 different plants between the two years.</span></li>
          <li class="flex gap-3"><span style="color:hsl(var(--eden-gold-ink))">·</span><span><strong>Extra Student Notebooks for either year,</strong> $39.99 each for the first five across both years, $32 each after that, in the same parcel (shipping calculated in your cart).</span></li>
          <li class="flex gap-3"><span style="color:hsl(var(--eden-gold-ink))">·</span><span><strong>Printed to order, mailed to you,</strong> tracked, within the United States.</span></li>
        </ul>
      </div>
      <div id="buy-both" class="md:sticky md:top-24 min-[1024px]:top-36">
        <PrintBuyBox client:only="react" cta="books-buy-both" band="both" />
      </div>
    </div>
  </section>

  <section class="py-12 px-6 bg-background">
    <div class="max-w-2xl mx-auto">
      <h2 class="font-serif text-2xl font-bold mb-6 text-center" style="color:hsl(var(--eden-forest))">Questions I get asked</h2>
      <div class="space-y-4">
        {faqs.map((f) => (
          <div class="rounded-lg p-5 bg-white border" style="border-color:hsl(var(--eden-gold) / 0.3)">
            <h3 class="font-serif text-base font-bold mb-1" style="color:hsl(var(--eden-forest))">{f.q}</h3>
            <p class="font-body text-sm text-muted-foreground leading-relaxed">{f.a}</p>
          </div>
        ))}
      </div>
      <p class="font-body text-sm text-muted-foreground text-center mt-8">
        For you, the parent: <a href="/back-to-eden" data-cta="books-to-bte" class="underline" style="color:hsl(var(--eden-forest))">Back to Eden</a>, the book behind the curriculum, in print or as a download.
      </p>
      <p class="font-body text-sm text-muted-foreground text-center mt-3">
        Anything else, email me: <a href="mailto:hello@edeninstitute.health" class="underline" style="color:hsl(var(--eden-forest))">hello@edeninstitute.health</a>
      </p>
    </div>
  </section>
</MarketingLayout>
