---
// The full-bleed botanical plate behind a marketing hero, the image Lighthouse
// measures as the page's Largest Contentful Paint on a phone.
//
// Same picture, same pixels, same placement as the plain <img> it replaces:
//   - the plate is served at its full original width in AVIF (16-47% smaller
//     than the JPEG), and the original JPEG stays as the <img> for any browser
//     without AVIF. No WebP step: at a quality that holds these plates, WebP
//     came out as large as the JPEG or larger. No downscaled copies:
//     object-cover on a tall phone hero shows the plate at close to its full
//     height, so a narrower file would render softer.
//   - fetchpriority="high", because it is the LCP element and should not wait
//     behind scripts.
// The <picture> wrapper is display:contents, so it generates no box of its
// own: it cannot become a flex item in a flex hero (the homepage's is one), and
// the absolute inset-0 <img> still sizes against the hero <section>, exactly
// as before.
//
// Quality was checked against the original JPEG (PSNR, 2026-09-28): AVIF 60
// holds 37-41 dB on the 90-95% opacity plates; the homepage plate runs at 32%
// opacity, which scales any difference down by the same factor, so it uses 50.
import { getImage } from "astro:assets";
import type { ImageMetadata } from "astro";

export interface Props {
  src: ImageMetadata;
  /** The plate's opacity, exactly as the page had it inline. */
  opacity: number;
  /** AVIF quality. Default 60; see the note above. */
  avifQuality?: number;
}

const { src, opacity, avifQuality = 60 } = Astro.props;

const avif = await getImage({ src, format: "avif", quality: avifQuality, width: src.width });
---

<picture style="display:contents">
  <source type="image/avif" srcset={avif.src} />
  <img
    src={src.src}
    width={src.width}
    height={src.height}
    alt=""
    aria-hidden="true"
    fetchpriority="high"
    class="absolute inset-0 w-full h-full object-cover pointer-events-none select-none"
    style={`opacity:${opacity};mix-blend-mode:multiply`}
  />
</picture>
