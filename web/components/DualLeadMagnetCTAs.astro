---
// Sprouts + Seedlings free-preview CTA pair. Static buttons (rendered by Astro
// for SEO) carrying data-waitlist-* attributes; WaitlistController wires the
// clicks to the modal. Mirrors the DualLeadMagnetCTAs helper in Homeschool.tsx.
import { Button } from "@/components/ui/button";
import { FREE_WEEK_MODAL } from "../lib/freeWeekModal";

interface Props {
  size?: "lg" | "xl";
  variant?: "eden" | "eden-outline";
}
const { size = "lg", variant = "eden-outline" } = Astro.props;

// The pop-up wording (title, subtitle, button, success line) lives in
// web/lib/freeWeekModal.ts, shared with the /homeschool band ladders since
// 2026-10-14, so the two pages can no longer drift apart.
const sprouts = FREE_WEEK_MODAL.sprouts;
const seedlings = FREE_WEEK_MODAL.seedlings;
---

{/*
  The className here is not decoration, it stops these buttons breaking the
  page on a phone. The shadcn base carries whitespace-nowrap and size="lg" is
  h-12 px-10, so an unwrappable label plus 80px of horizontal padding rendered
  each button 411px wide inside a 375px viewport: 18px clipped off BOTH edges,
  on the free-sample capture page that feeds the whole email sequence.
  Measured 2026-07-28.

  whitespace-normal lets the label wrap, h-auto + min-h-[48px] stops wrapped
  text being clipped by the fixed height while keeping the 44px tap target,
  and px-6 gives the text room back on small screens. w-full sm:w-auto because
  the parent is flex-col on mobile (fill) and flex-row above it (share).
  Same shape as the buttons the old courses page used (removed 2026-10-14), which solved this.
*/}
<div class="flex flex-col sm:flex-row gap-3 justify-center items-stretch">
  <Button
    variant={variant}
    size={size}
    className="w-full sm:w-auto whitespace-normal h-auto min-h-[48px] py-3 px-6 sm:px-10 leading-snug"
    data-waitlist-source={sprouts.source}
    data-waitlist-cta-href="https://edeninstitute.health/homeschool?utm_source=modal&utm_medium=post_signup&utm_campaign=free_weeks_followup"
    data-waitlist-cta-label="See the full year"
    data-waitlist-cta-blurb="While you wait: families have taught this at their own tables. Here is what they said, and what a full year looks like."
    data-waitlist-title={sprouts.title}
    data-waitlist-subtitle={sprouts.subtitle}
    data-waitlist-submit-label={sprouts.submitLabel}
    data-waitlist-success-message={sprouts.successMessage}
    data-waitlist-success-subtitle={sprouts.successSubtitle}
  >
    Get Sprouts (K-2) Week 1 · Free
  </Button>
  <Button
    variant={variant}
    size={size}
    className="w-full sm:w-auto whitespace-normal h-auto min-h-[48px] py-3 px-6 sm:px-10 leading-snug"
    data-waitlist-source={seedlings.source}
    data-waitlist-cta-href="https://edeninstitute.health/homeschool?utm_source=modal&utm_medium=post_signup&utm_campaign=free_weeks_followup"
    data-waitlist-cta-label="See the full year"
    data-waitlist-cta-blurb="While you wait: families have taught this at their own tables. Here is what they said, and what a full year looks like."
    data-waitlist-title={seedlings.title}
    data-waitlist-subtitle={seedlings.subtitle}
    data-waitlist-submit-label={seedlings.submitLabel}
    data-waitlist-success-message={seedlings.successMessage}
    data-waitlist-success-subtitle={seedlings.successSubtitle}
  >
    Get Seedlings (3-5) Week 1 · Free
  </Button>
</div>
