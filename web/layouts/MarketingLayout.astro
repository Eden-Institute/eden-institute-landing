---
// Shared marketing-page shell. Emits the full <head> (ported from index.html)
// with PER-PAGE title/description/canonical/OG and optional page JSON-LD baked
// into the static HTML — so crawlers read the real content with no JS.
import "@/index.css";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import SiteAnalytics from "../components/islands/SiteAnalytics.tsx";

export interface Props {
  title: string;
  description: string;
  canonical: string;
  ogImage?: string;
  ogType?: "website" | "article";
  /** Page-specific structured data (e.g. Course, FAQPage). Object or array. */
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  /** Pages with their own bespoke footer (e.g. the homepage) opt out of the
      shared <Footer />. Defaults to false so all other pages are unaffected. */
  hideFooter?: boolean;
  /** Private, link-only pages (e.g. /partner-sample) keep themselves out of the
      index. Defaults to false, so every existing page stays "index, follow". */
  noindex?: boolean;
}

const {
  title,
  description,
  canonical,
  ogImage = "https://edeninstitute.health/og-home-v1.4.png",
  ogType = "website",
  jsonLd,
  hideFooter = false,
  noindex = false,
} = Astro.props;

// Sitewide identity — present on every marketing page.
const orgJsonLd = {
  "@context": "https://schema.org",
  "@type": "Organization",
  name: "The Eden Institute",
  url: "https://edeninstitute.health",
  logo: "https://edeninstitute.health/favicon.ico",
  description: "A structured, worldview-anchored, terrain-based clinical herbalism institute.",
  parentOrganization: { "@type": "Organization", name: "Rooted in Faith Ventures" },
  sameAs: ["https://twitter.com/edeninstitute"],
};
const websiteJsonLd = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: "The Eden Institute",
  url: "https://edeninstitute.health/",
};
const pageJsonLd = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <!-- Google Tag Manager (Curious Mind Marketplace container) -->
    <script is:inline>(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
    new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
    j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
    'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
    })(window,document,'script','dataLayer','GTM-PVRHXN8N');</script>
    <!-- End Google Tag Manager -->
    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-5DVHEZPKL0"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-5DVHEZPKL0');
    </script>

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content={noindex ? "noindex, nofollow" : "index, follow"} />
    <meta name="author" content="The Eden Institute" />
    <meta name="theme-color" content="#1C3A2E" />

    <!-- Favicons (Eden's Table seedling mark) -->
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <!-- Domain verification (Pinterest + Meta) -->
    <meta name="p:domain_verify" content="590bb4ccc9cb42cfe49a5d33b3e7c57a" />
    <meta name="facebook-domain-verification" content="qfhisezad6uhdic7dugiew03fzzinf" />

    <!-- Open Graph / Twitter -->
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@edeninstitute" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <script type="application/ld+json" set:html={JSON.stringify(orgJsonLd)} />
    <script type="application/ld+json" set:html={JSON.stringify(websiteJsonLd)} />
    {pageJsonLd.map((block) => (
      <script type="application/ld+json" set:html={JSON.stringify(block)} />
    ))}

    {/*
      Pinterest tag. Tag ID 2613485320295, read off ads.pinterest.com for
      advertiser 549770068824 (the TheEdenInstitute ad account) on 2026-07-26 —
      NOT the advertiser id, which is a different number. Verify in Pinterest's
      Tag manager before changing it.

      Lives here rather than in the SPA entry because every ad landing page is
      Astro: /preorder, /homeschool, /courses. The SPA is behind auth and is not
      an ad destination, so tagging it would add tracking without adding signal.

      The `checkout` conversion fires from /preorder itself, because Stripe's
      success_url returns buyers to /preorder?checkout=success. See preorder.astro.
    */}
    <script is:inline>
      !function(e){if(!window.pintrk){window.pintrk=function(){window.pintrk.queue.push(
      Array.prototype.slice.call(arguments))};var n=window.pintrk;n.queue=[],n.version="3.0";
      var t=document.createElement("script");t.async=!0,t.src=e;var r=document.getElementsByTagName("script")[0];
      r.parentNode.insertBefore(t,r)}}("https://s.pinimg.com/ct/core.js");
      pintrk('load', '2613485320295');
      pintrk('page');
    </script>
    <noscript>
      <img height="1" width="1" style="display:none;" alt=""
        src="https://ct.pinterest.com/v3/?event=init&tid=2613485320295&noscript=1" />
    </noscript>
  </head>
  <body>
    <!-- Google Tag Manager (noscript) -->
    <noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-PVRHXN8N"
    height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
    <!-- End Google Tag Manager (noscript) -->
    <Navbar />
    <slot />
    {hideFooter ? null : <Footer />}
    {/* client:only — never server-rendered. The shared Supabase client touches
        localStorage at module load, and analytics/consent is a browser-only
        concern with no SEO value, so it must not run during the static build. */}
    <SiteAnalytics client:only="react" />
  </body>
</html>
