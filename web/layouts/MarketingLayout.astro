---
// Shared marketing-page shell. Emits the full <head> (ported from index.html)
// with PER-PAGE title/description/canonical/OG and optional page JSON-LD baked
// into the static HTML — so crawlers read the real content with no JS.
import "@/index.css";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import SiteAnalytics from "../components/islands/SiteAnalytics.tsx";
import { CHECKOUT_SESSION_STRIP_JS } from "@/lib/checkoutSession";
import { SOCIALS } from "@/lib/socials";

export interface Props {
  title: string;
  description: string;
  canonical: string;
  ogImage?: string;
  ogType?: "website" | "article" | "product";
  /** Product Rich Pin tags, for a single-product page someone can buy from.
      Emitted only when ogType is "product". Pinterest reads product:price:amount
      (no currency sign) and product:price:currency, plus og:availability.
      Pass the same price the page's Product JSON-LD carries. */
  product?: {
    priceAmount: string;
    priceCurrency: string;
    availability: "instock" | "preorder" | "backorder" | "out of stock" | "discontinued";
    brand?: string;
  };
  /** Page-specific structured data (e.g. Course, FAQPage). Object or array. */
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  /** Pages with their own bespoke footer (e.g. the homepage) opt out of the
      shared <Footer />. Defaults to false so all other pages are unaffected. */
  hideFooter?: boolean;
  /** Private, link-only pages (e.g. /partner-sample) keep themselves out of the
      index. Defaults to false, so every existing page stays "index, follow". */
  noindex?: boolean;
  /** Pages that render their own header opt out of the shared <Navbar />.
      Defaults to false so all other pages are unaffected. Added for /curriculum,
      the page scholarship reviewers see: the shared navbar carries "Biblical
      Herbalism Education" and "Shop Quality Herbs", which is the framing state
      ESA programs cannot place under an approved subject. */
  hideNav?: boolean;
  /** Overrides the sitewide Organization JSON-LD description for one page.
      Defaults to the institute description, so every existing page is unchanged. */
  orgDescription?: string;
  /** Extra origins to preconnect for this page only (e.g. a third-party image
      host its hero loads from). Emitted without crossorigin, which suits plain
      <img> and CSS background requests. Defaults to none. */
  preconnect?: string[];
  /** Private pages whose URL carries a credential load NO third-party tags.
      Set by /starter/downloads (?t=, the durable Starter download token) and
      /partner-sample (?k=, the partner key). The credential stays in the URL on
      purpose, so the emailed link, a copied link, a bookmark, a home screen
      shortcut and "Open in Safari" all keep working on any device. What makes
      that safe is that nothing third party is on the page to read it:
        no Google Tag Manager, no Google Analytics (gtag), no Pinterest tag, no
        Meta Pixel, and no cookie banner, because nothing left on the page
        needs consent.
      It also adds <meta name="referrer" content="no-referrer">, so no request
      the page makes (fonts, images, the file downloads) and no page opened from
      it is told the URL. The session id strip script stays first, unchanged,
      and the cookieless first-party page view still records the path only.
      Defaults to false, so every other page keeps all of its tags.
      Test: src/test/privatePagesNoTags.astro.test.ts renders every page. */
  noThirdPartyTags?: boolean;
}

// Default share card: public/og-default-printset.jpg, 1200 x 630. Width and
// height are emitted only for this default, since a page-supplied image may
// have other dimensions.
const DEFAULT_OG_IMAGE = "https://edeninstitute.health/og-default-printset.jpg";

const {
  title,
  description,
  canonical,
  ogImage = DEFAULT_OG_IMAGE,
  ogType = "website",
  product,
  jsonLd,
  hideFooter = false,
  noindex = false,
  hideNav = false,
  orgDescription = "A structured, worldview-anchored, terrain-based clinical herbalism institute.",
  preconnect = [],
  noThirdPartyTags = false,
} = Astro.props;

// Sitewide identity — present on every marketing page.
const orgJsonLd = {
  "@context": "https://schema.org",
  "@type": "Organization",
  name: "The Eden Institute",
  url: "https://edeninstitute.health",
  logo: "https://edeninstitute.health/favicon-512.png",
  description: orgDescription,
  parentOrganization: { "@type": "Organization", name: "Rooted in Faith Ventures" },
  sameAs: [...SOCIALS.map((s) => s.href), "https://twitter.com/edeninstitute"],
};
const websiteJsonLd = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: "The Eden Institute",
  url: "https://edeninstitute.health/",
};
const pageJsonLd = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    {/*
      Private page (noThirdPartyTags): before anything in the head can fetch,
      so the URL with its credential is never sent as a Referer, and a page
      opened from here gets an empty document.referrer.
    */}
    {noThirdPartyTags && <meta name="referrer" content="no-referrer" />}
    {/*
      Stripe session id out of the URL, the VERY FIRST script, on every page.
      /books/thank-you and /starter/thank-you arrive as ?session_id=cs_..., a
      bearer credential. This moves it into sessionStorage (and a window global
      for this page load) and removes only that param from the address bar
      before GTM, gtag('config') or the Pinterest tag can read location.href or
      pass it on as the next page's referrer. The pages read it back with
      readCheckoutSessionId(). Source and reasoning: src/lib/checkoutSession.ts.
    */}
    <script is:inline set:html={CHECKOUT_SESSION_STRIP_JS}></script>
    {/*
      Third-party tags, in three guarded blocks: the consent script, GTM and
      gtag just below, the Pinterest tag after the JSON-LD, and the GTM
      noscript at the top of <body>. All three are left out of a private page
      (noThirdPartyTags), and SiteAnalytics is told not to load the Meta Pixel
      or show the cookie banner there.
    */}
    {!noThirdPartyTags && (<>
    {/*
      Consent opt-out, first after the session-id strip above (founder decision 2026-09-13: run by
      default, Decline turns it off). Google Analytics and the Pinterest tag
      below run for every visitor until they click Decline on the cookie banner,
      stored as localStorage 'eden-marketing-consent' = 'denied'
      (src/lib/consent.ts). For that visitor this runs before the GTM and gtag
      snippets on every page load:
        window['ga-disable-G-5DVHEZPKL0'] = true  Google's switch that stops the
                                                  Google tag setting cookies or
                                                  sending data
        gtag('consent', 'default', denied)        before gtag('config'), as
                                                  Google requires
      The Pinterest half is in the Pinterest snippet further down, before
      pintrk('load') and pintrk('page'). The click itself is handled by
      applyTagConsent() in src/lib/consent.ts.
    */}
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      try {
        if (localStorage.getItem('eden-marketing-consent') === 'denied') {
          window['ga-disable-G-5DVHEZPKL0'] = true;
          gtag('consent', 'default', { analytics_storage: 'denied', ad_storage: 'denied', ad_user_data: 'denied', ad_personalization: 'denied' });
        }
      } catch (e) {}
    </script>
    <!-- Google Tag Manager (Curious Mind Marketplace container) -->
    <script is:inline>(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
    new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
    j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
    'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
    })(window,document,'script','dataLayer','GTM-PVRHXN8N');</script>
    <!-- End Google Tag Manager -->
    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-5DVHEZPKL0"></script>
    <script is:inline>
      gtag('js', new Date());
      gtag('config', 'G-5DVHEZPKL0');
    </script>
    </>)}

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    {preconnect.map((origin) => (
      <link rel="preconnect" href={origin} />
    ))}
    <meta name="robots" content={noindex ? "noindex, nofollow" : "index, follow"} />
    <meta name="author" content="The Eden Institute" />
    <meta name="theme-color" content="#1C3A2E" />

    <!-- Favicons (Eden's Table seedling mark) -->
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <!-- Domain verification (Pinterest + Meta) -->
    <meta name="p:domain_verify" content="590bb4ccc9cb42cfe49a5d33b3e7c57a" />
    <meta name="facebook-domain-verification" content="qfhisezad6uhdic7dugiew03fzzinf" />

    <!-- Open Graph / Twitter -->
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    {ogImage === DEFAULT_OG_IMAGE && (
      <>
        <meta property="og:image:width" content="1200" />
        <meta property="og:image:height" content="630" />
      </>
    )}
    {ogType === "product" && product && (
      <>
        <meta property="og:site_name" content="The Eden Institute" />
        {product.brand && <meta property="og:brand" content={product.brand} />}
        <meta property="product:price:amount" content={product.priceAmount} />
        <meta property="product:price:currency" content={product.priceCurrency} />
        <meta property="og:availability" content={product.availability} />
      </>
    )}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@edeninstitute" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <script type="application/ld+json" set:html={JSON.stringify(orgJsonLd)} />
    <script type="application/ld+json" set:html={JSON.stringify(websiteJsonLd)} />
    {pageJsonLd.map((block) => (
      <script type="application/ld+json" set:html={JSON.stringify(block)} />
    ))}

    {/*
      Pinterest tag. Tag ID 2613485320295, read off ads.pinterest.com for
      advertiser 549770068824 (the TheEdenInstitute ad account) on 2026-07-26 —
      NOT the advertiser id, which is a different number. Verify in Pinterest's
      Tag manager before changing it.

      Lives here rather than in the SPA entry because every ad landing page is
      Astro: /books, /starter, /homeschool, /freebies, /courses. The SPA is behind
      auth and is not an ad destination, so tagging it would add tracking without
      adding signal.

      Conversion events ride on this tag via src/lib/pinterestTag.ts:
        lead      WaitlistModal, after resend-waitlist confirms the signup
        addtocart PrintBuyBox (/books) and StarterBuyBox (/starter), on click
        checkout  PrintThankYou (/books/thank-you) and StarterDownloads
                  (/starter/thank-you), once the order is confirmed paid
      The old /preorder checkout event went with that storefront in #475.

      Consent: the setconsent line runs only for a visitor who clicked Decline.
      It is queued before 'load' and 'page', and core.js replays the queue in
      order, so for that visitor the tag sends no page event and makes no
      cookie request (Pinterest's library keeps consent in memory, which is why
      this is repeated on every page load). Accept or Decline clicks call
      applyTagConsent() in src/lib/consent.ts. The noscript pixel below cannot
      read the choice; a visitor without JavaScript also never sees the banner.
    */}
    {!noThirdPartyTags && (<>
    <script is:inline>
      !function(e){if(!window.pintrk){window.pintrk=function(){window.pintrk.queue.push(
      Array.prototype.slice.call(arguments))};var n=window.pintrk;n.queue=[],n.version="3.0";
      var t=document.createElement("script");t.async=!0,t.src=e;var r=document.getElementsByTagName("script")[0];
      r.parentNode.insertBefore(t,r)}}("https://s.pinimg.com/ct/core.js");
      try { if (localStorage.getItem('eden-marketing-consent') === 'denied') pintrk('setconsent', false); } catch (e) {}
      pintrk('load', '2613485320295');
      pintrk('page');
    </script>
    <noscript>
      <img height="1" width="1" style="display:none;" alt=""
        src="https://ct.pinterest.com/v3/?event=init&tid=2613485320295&noscript=1" />
    </noscript>
    </>)}
  </head>
  <body>
    {!noThirdPartyTags && (<>
    <!-- Google Tag Manager (noscript) -->
    <noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-PVRHXN8N"
    height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
    <!-- End Google Tag Manager (noscript) -->
    </>)}
    {hideNav ? null : <Navbar />}
    <slot />
    {hideFooter ? null : <Footer />}
    {/* client:only — never server-rendered. The shared Supabase client touches
        localStorage at module load, and analytics/consent is a browser-only
        concern with no SEO value, so it must not run during the static build.
        thirdPartyTags={false} on a private page: no Meta Pixel, no banner. */}
    <SiteAnalytics client:only="react" thirdPartyTags={!noThirdPartyTags} />
  </body>
</html>
