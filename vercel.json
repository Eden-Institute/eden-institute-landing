{
  "redirects": [
    {
      "source": "/Homeschool",
      "destination": "/homeschool",
      "permanent": true
    },
    {
      "source": "/app",
      "destination": "/apothecary",
      "permanent": true
    },
    {
      "source": "/app/:path*",
      "destination": "/apothecary/:path*",
      "permanent": true
    },
    {
      "source": "/go/deep-dive/:slug",
      "destination": "https://noeqztssupewjidpvhar.supabase.co/functions/v1/guide-checkout?slug=:slug",
      "permanent": false
    },
    {
      "source": "/partner-sample/:key",
      "destination": "/partner-sample?k=:key",
      "permanent": false
    },
    {
      "source": "/partner-sample/:key/(.*)",
      "destination": "/partner-sample?k=:key",
      "permanent": false
    },
    {
      "source": "/:page((?!partner-sample)[Pp][Aa][Rr][Tt][Nn][Ee][Rr]-[Ss][Aa][Mm][Pp][Ll][Ee])",
      "destination": "/partner-sample",
      "permanent": false
    },
    {
      "source": "/:page((?!partner-sample)[Pp][Aa][Rr][Tt][Nn][Ee][Rr]-[Ss][Aa][Mm][Pp][Ll][Ee])/:rest(.*)",
      "destination": "/partner-sample/:rest",
      "permanent": false
    },
    {
      "source": "/starter/downloads/(.+)",
      "destination": "/starter/downloads",
      "permanent": false
    },
    {
      "source": "/:page((?!starter/downloads)[Ss][Tt][Aa][Rr][Tt][Ee][Rr]/[Dd][Oo][Ww][Nn][Ll][Oo][Aa][Dd][Ss])",
      "destination": "/starter/downloads",
      "permanent": false
    },
    {
      "source": "/:page((?!starter/downloads)[Ss][Tt][Aa][Rr][Tt][Ee][Rr]/[Dd][Oo][Ww][Nn][Ll][Oo][Aa][Dd][Ss])/(.*)",
      "destination": "/starter/downloads",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/preorder-response",
      "destination": "https://noeqztssupewjidpvhar.supabase.co/functions/v1/preorder-response"
    },
    {
      "source": "/go/course",
      "destination": "/api/go/course"
    },
    {
      "source": "/((?!_astro/|_spa/|api/|favicon|robots\\.txt|sitemap\\.xml|.*\\.(?:png|svg|jpg|jpeg|webp|gif|ico|txt|xml|json|js|css|map|woff2?|pdf|html|mp4|webm|mp3|csv|zip|ttf|otf)).*)",
      "destination": "/_spa/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/drain-nurture-queue",
      "schedule": "*/15 * * * *"
    },
    {
      "path": "/api/cron/replay-quiz-failures",
      "schedule": "*/30 * * * *"
    },
    {
      "path": "/api/cron/notify-founder-digest",
      "schedule": "0 14 * * *"
    },
    {
      "path": "/api/cron/notify-founder-digest-retry",
      "schedule": "37 14 * * *"
    },
    {
      "path": "/api/cron/weekly-trends-digest",
      "schedule": "0 14 * * 5"
    },
    {
      "path": "/api/cron/weekly-trends-digest-retry",
      "schedule": "37 14 * * 5"
    },
    {
      "path": "/api/cron/founder-evening-recap",
      "schedule": "0 1 * * *"
    },
    {
      "path": "/api/cron/founder-evening-recap-retry",
      "schedule": "37 1 * * *"
    },
    {
      "path": "/api/cron/launch-email-preview",
      "schedule": "0 15 * * *"
    },
    {
      "path": "/api/cron/drain-starter-deliveries",
      "schedule": "*/10 * * * *"
    },
    {
      "path": "/api/cron/drain-lulu-jobs",
      "schedule": "*/10 * * * *"
    },
    {
      "path": "/api/cron/sync-contact-properties",
      "schedule": "30 8 * * *"
    },
    {
      "path": "/api/cron/esa-daily",
      "schedule": "0 15 * * *"
    }
  ]
}
