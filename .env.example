# Supabase (noeqz... project)
# Obtain these from: https://supabase.com/dashboard/project/<project-id>/settings/api
VITE_SUPABASE_URL="https://<project-id>.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."

# ----------------------------------------------------------------------------
# Server-side secrets live in Supabase Edge Function secrets, NOT in this file.
# Never put them in a VITE_ variable. Current production state, 2026-09-12:
#
# PRINT_SHOP_LIVE=true          # printed set checkout on /books is open
# PREORDERS_LIVE=false          # kit preorders CLOSED 2026-09-12, keep false
# LULU_API_BASE=<production>    # never the sandbox URL in production
# LULU_SHIPPING_LEVEL=MAIL
# ----------------------------------------------------------------------------

# ----------------------------------------------------------------------------
# Vercel project settings (api/ serverless crons + /partner-sample). Set in the
# Vercel dashboard, never in a VITE_ variable, never committed:
#
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=
# CRON_SECRET=
# PARTNER_SAMPLE_KEY=
# (api/ also falls back to VITE_SUPABASE_URL when SUPABASE_URL is unset)
# ----------------------------------------------------------------------------
